{
  "extends": "./tsconfig.json",
  "exclude": [
    "**/*.e2e-spec.ts",
    "**/*.spec.ts",
    "**/*spec.ts",
    "dist",
    "node_modules",
    "prisma",
    "prisma.config.ts",
    "src/admin/schedule-templates/**/*",
    "src/brain/**/*",
    "src/schedule/**/*",
    "src/student/student.classrooms.controller.ts",
    "test"
  ],
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "src",
    "noEmit": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "incremental": false,
    "composite": false
  },
  "include": [
    "src/**/*.ts"
  ]
}
