{
  "extends": "./tsconfig.json",
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "prisma",
    "prisma.config.ts",
    "**/*.spec.ts",
    "**/*.e2e-spec.ts"
  ],
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "src",
    "noEmit": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "incremental": false,
    "composite": false
  },
  "include": [
    "src/**/*.ts"
  ]
}
