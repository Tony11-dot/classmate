generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
  PARENT
  SECRETARY
}

enum AccountStatus {
  AUTH_ONLY
  PENDING
  ACTIVE
}

enum ParentChildStatus {
  PENDING
  APPROVED
}

enum AssignmentTargetType {
  EVERYONE
  COHORT
  STUDENTS
}

model School {
  id                String   @id @default(uuid())
  name              String
  logoUrl           String?
  minGrade          Int      @default(5)
  maxGrade          Int      @default(12)
  /// Optional multi-range grade coverage, e.g. "4-6,9-12" when a school skips
  /// grades 7-8. Empty/null means the single contiguous minGrade..maxGrade.
  /// minGrade/maxGrade are always kept in sync with the overall min/max so all
  /// existing consumers keep working.
  gradeRanges       String?
  /// School-year semesters as month ranges, e.g. "9-1,2-6" (Sem 1 = Sep→Jan,
  /// Sem 2 = Feb→Jun; wrap-around allowed). Index+1 = "Semester N". A record
  /// maps to a semester by its date, so existing data is covered automatically.
  semesters         String?
  /// Year of the most recent Sept-1 grade bump that succeeded for this
  /// school.  The bump runs at most once per year per school and is idempotent
  /// — see GradeBumpService.
  lastGradeBumpYear Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  users          User[]
  forms          SchoolForm[]
  diplomas       TeacherDiploma[]
  periodDefaults SchoolPeriodDefault[]
  classrooms     Classroom[]
  scheduleSlots  ScheduleSlot[]
}

model User {
  id                      String                   @id @default(uuid())
  email                   String?                  @unique
  /// Primary login identifier. Generated automatically from the email
  /// local-part on signup if not explicitly supplied. Nullable on the
  /// column for back-compat with legacy NULL rows (4 such on prod as of
  /// 2026-05-27); application code now always writes a value. Tighten to
  /// NOT NULL once the deploy switches from `prisma db push` to a proper
  /// migration runner that respects the 20260527_username_required SQL.
  username                String?                  @unique
  password                String
  /// Reversible (AES-256-GCM) copy of the user's current credential, kept ONLY
  /// so admins can re-export the same password without resetting the login.
  /// `password` above remains the one-way bcrypt hash used for auth. Written
  /// whenever a password is set/changed; see common/password-vault.ts.
  passwordEnc             String?
  name                    String
  parentNotificationState ParentNotificationState?

  // school affiliation
  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  // Identity / profile. `name` is the single full-name source of truth —
  // the old per-user `displayName` override and the per-language name columns
  // (nameEn/Ar/He/Fr/Ru + displayNameLang) were removed: one full name,
  // everywhere, in every language.
  legalName   String?
  phone       String?
  status      AccountStatus @default(AUTH_ONLY)

  /// The user's chosen UI language ('en'|'ar'|'he'|'fr'|'ru'|'ps'), pushed by
  /// the app whenever the locale changes. Used to localize notification copy
  /// per recipient (in-app inbox + system push). Null → English.
  language    String?

  // optional future tzfonet fields
  tzfonetEmail      String?
  tzfonetVerifiedAt DateTime?

  /// Set when the user has confirmed a verification code sent to their
  /// current email. Null = unverified. Cleared (set to null) on email change
  /// — the new value must be re-verified before it can be used for resets.
  emailVerifiedAt DateTime?
  /// Set when the user has confirmed a verification code sent to their
  /// current phone via SMS. Same null-on-change semantics as emailVerifiedAt.
  phoneVerifiedAt DateTime?

  verificationCodes VerificationCode[]

  roles          UserRole[]
  studentProfile StudentProfile?

  // parent-child links
  parentLinks ParentChild[] @relation("ParentLinks")
  childLinks  ParentChild[] @relation("ChildLinks")

  scheduleSlots        ScheduleSlot[]     @relation("TeacherSlots")
  scheduleOverrides    ScheduleOverride[] @relation("TeacherOverrides")
  ownedClassrooms      Classroom[]        @relation("TeacherClassrooms")
  classroomMemberships ClassroomMember[]  @relation("ClassroomMemberships")

  createdAt             DateTime               @default(now())
  assessments           Assessment[]
  parentLinkCodes       ParentLinkCode[]
  announcements         Announcement[]
  announcementSeens     AnnouncementSeen[]
  parentNotifications   ParentNotification[]
  solutions             Solution[]
  notifications         Notification[]
  deviceTokens          DeviceToken[]
  solutionLikes         SolutionLike[]
  solutionComments      SolutionComment[]
  teachingTemplateSlots ScheduleTemplateSlot[] @relation("TeacherSlots")

  studentTemplateBinds StudentScheduleTemplate[]
  solutionReposts      SolutionRepost[]

  messageThreadMemberships MessageThreadMember[]
  sentMessages             Message[]
  messageReactions         MessageReaction[]
  messageRequestDecisions  MessageThread[]        @relation("MessageRequestDecisionUser")
  messageThreads           MessageThread[]
  assignmentSubmissions    AssignmentSubmission[]
  teacherForms             SchoolForm[]           @relation("TeacherForms")
  issuedDiplomas           TeacherDiploma[]       @relation("IssuedDiplomas")

  teacherAssignments           TeacherAssignment[]           @relation("TeacherAssignments")
  teacherAssignmentSubmissions TeacherAssignmentSubmission[] @relation("AssignmentStudent")
  teacherExams                 TeacherExam[]                 @relation("TeacherExams")
  teacherMaterials             TeacherMaterial[]             @relation("TeacherMaterials")
  teacherMeetings              TeacherMeeting[]              @relation("TeacherMeetings")

  // Billing relations — NOVA / Practice token economy.
  subscriptions UserSubscription[]
  tokenBalance  TokenBalance?
  tokenUsages   TokenUsage[]

  dmMessageReportsFiled DmMessageReport[] @relation("DmMessageReportsFiled")
  dmMessagesSent        DmMessage[]       @relation("DmMessagesSent")

  // Tenant key — every "users in school X" query filters on this; index it so
  // those reads don't seq-scan the user table as tenants grow.
  @@index([schoolId])
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  role   Role
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

/// One-time 6-digit code issued when a user wants to verify their current
/// email/phone or change it to a new value. Only the SHA-256 hash of the raw
/// code is stored; the raw value is sent to the user once via the matching
/// channel. `kind` distinguishes:
///   - 'verify-current' — confirming ownership of the stored value (no change)
///   - 'change'         — the code went to the OLD value; on confirm the user
///                        also supplies `newValue` and the change is applied
///                        with the new value marked unverified.
/// `target` is whatever value the code was sent TO (current value for both
/// kinds — the "send code to OLD when changing" guarantee).
model VerificationCode {
  id        String    @id @default(uuid())
  userId    String
  /// 'email' | 'sms' — selects which channel sent the code.
  channel   String
  /// 'verify-current' | 'change'
  kind      String
  /// Email address or E.164 phone the code was actually sent to.
  target    String
  /// Only used when kind = 'change'. The proposed new value the user wants
  /// to switch to once they prove ownership of the current `target`.
  newValue  String?
  /// SHA-256 hex digest of the raw 6-digit code.
  codeHash  String
  /// Hard expiry; rows past this are ignored.
  expiresAt DateTime
  /// Stamped the moment the code is redeemed. Used codes cannot be redeemed
  /// again — re-verify means asking for a fresh code.
  usedAt    DateTime?
  /// Bumped on every failed attempt; we lock after a small number to make
  /// brute-forcing 6-digit codes impractical without spamming new codes.
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, channel, kind])
  @@index([expiresAt])
}

/// Single-use, time-limited token issued by /auth/forgot-password and consumed
/// by /auth/reset-password. Only the SHA-256 hash of the raw token is stored;
/// the raw value is sent to the user via email or SMS exactly once.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  /// SHA-256 hex digest of the raw token.
  tokenHash String    @unique
  /// 'email' | 'sms' — for analytics/debug. Not used to validate.
  channel   String
  /// Hard expiry; rows past this are ignored even if unused.
  expiresAt DateTime
  /// Stamped the moment the token is redeemed. Tokens with usedAt != null cannot
  /// be redeemed again.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Cohort {
  id       String  @id @default(uuid())
  name     String  @unique // e.g. "10th-2"
  /// Primary/representative grade — kept in sync with grades[0] so legacy
  /// readers (announcements, schedule, teacher.service, etc.) keep working.
  grade    Int
  /// Authoritative grade list. Multi-grade cohorts have length > 1.
  grades   Int[]   @default([])
  schoolId String? // null = legacy/global; non-null = school-scoped

  students              StudentProfile[]
  studentLinks          StudentCohort[]
  slotCohorts           ScheduleSlotCohort[]
  joinCodes             CohortJoinCode[]
  scheduleOverrides     ScheduleOverride[]
  attendanceSessions    AttendanceSession[]
  scheduleTemplateBinds CohortScheduleTemplate[]
  assessments           Assessment[]

  @@index([schoolId])
}

model CohortJoinCode {
  id        String    @id @default(uuid())
  cohortId  String
  codeHash  String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@index([cohortId])
}

/// Direct many-to-many link between students and cohorts.
/// Replaces the course-enrollment detour that getStudentCohortIds used before.
model StudentCohort {
  studentId String
  cohortId  String
  joinedAt  DateTime @default(now())

  student StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  cohort  Cohort         @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@id([studentId, cohortId])
  @@index([cohortId])
  @@index([studentId])
}

model StudentProfile {
  userId       String  @id
  cohortId     String?
  grade        Int? // primary grade level for this student
  englishLevel Int     @default(0)
  mathLevel    Int     @default(0)

  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohort            Cohort?               @relation(fields: [cohortId], references: [id])
  cohorts           StudentCohort[]
  studentMajors     StudentMajor[]
  attendanceRecords AttendanceRecord[]
  gradeRecords      GradeRecord[]
  slotStudents      ScheduleSlotStudent[]
  // ===== AI BRAIN (v1) =====
  brainProfile      StudentBrainProfile?
  brainSkills       StudentBrainSkill[]
  brainEvents       StudentBrainEvent[]
  brainSummary      StudentBrainSummary?
  formResponses     FormResponse[]

  @@index([cohortId])
}

model ParentChild {
  id       String            @id @default(uuid())
  parentId String
  childId  String
  status   ParentChildStatus @default(APPROVED)

  parent User @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)
  child  User @relation("ChildLinks", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId])
  @@index([parentId])
  @@index([childId])
}

model Major {
  id   String @id @default(uuid())
  name String @unique

  students StudentMajor[]
}

model StudentMajor {
  id        String @id @default(uuid())
  studentId String
  majorId   String

  student StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  major   Major          @relation(fields: [majorId], references: [id], onDelete: Cascade)

  @@unique([studentId, majorId])
  @@index([majorId])
}

enum MessageThreadType {
  DIRECT
  GROUP
}

enum MessageRequestState {
  NONE
  PENDING_INCOMING
  PENDING_OUTGOING
  APPROVED
  BLOCKED
}

enum MessageKind {
  TEXT
  IMAGE
  FILE
  VOICE
  SYSTEM
}

enum MessageDeleteMode {
  NONE
  DELETE_FOR_ME
  DELETE_FOR_EVERYONE
  MODERATOR_REMOVED
}

model ScheduleSlot {
  id                String   @id @default(uuid())
  schoolId          String?
  dayOfWeek         Int
  period            Int
  teacherId         String?
  classroomId       String?
  subject           String?
  /// Optional per-period color override (`#RRGGBB`).  Falls back to the
  /// subject's color, then to a deterministic palette hue if both are null.
  color             String?
  /// When the admin picked "By Grade N" in Add Period, this is N.  The
  /// resolved audience is still stored as cohortIds (so attendance/lookup
  /// queries don't change), but this field records the original intent so
  /// the grid label can read "Grade N" and edit mode restores the picker.
  audienceGrade     Int?
  startTime         String? // override school default, e.g. "08:00"
  endTime           String? // override school default, e.g. "08:45"
  frequencyWeeks    Int      @default(1) // 1=every week, 2=bi-weekly, 4=monthly, etc. 0=one-off (anchored to startDate).
  startDate         String? // ISO date "YYYY-MM-DD" of the first occurrence for bi-weekly etc.
  /// Optional free-text caption shown above "subject · teacher" on the
  /// schedule tile.  Lets admins annotate a slot (e.g. "Quiz day",
  /// "Lab session") without renaming the subject.
  caption           String?
  /// YYYY-MM-DD strings. The slot skips rendering on these dates, used when
  /// a Once override replaces this recurring slot just for the override
  /// date.  Mutated via the conflict dialog's "Override" action.
  skipDates         String[] @default([])
  /// LEGACY — forever-scoped per-student skip from an earlier override
  /// design. The new override flow writes to `studentDateSkips` instead
  /// (date-scoped, restores automatically after the override date), and
  /// this field is no longer read on the schedule path. Kept on the
  /// model so historical rows don't fail Prisma's strict scalar fetch;
  /// safe to drop in a later migration once everyone's caught up.
  skipForStudentIds String[] @default([])
  /// Per-student per-date suppression for the conflict-override flow.
  /// Each entry is "{studentId}:{YYYY-MM-DD}". When admin picks
  /// Override on a Once draft that conflicts with this slot, the
  /// affected students + the draft's anchor date are appended here.
  /// The slot still renders for those students on every OTHER date, so
  /// the override scope matches the overriding period's lifetime —
  /// when the Once override's date passes (or it's deleted by clearing
  /// the entries), the original slot reappears automatically.
  studentDateSkips  String[] @default([])

  school    School?                @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  teacher   User?                  @relation("TeacherSlots", fields: [teacherId], references: [id], onDelete: SetNull)
  classroom Classroom?             @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  students  ScheduleSlotStudent[]
  cohorts   ScheduleSlotCohort[]
  materials ScheduleSlotMaterial[]

  @@index([schoolId])
  @@index([teacherId])
  @@index([classroomId])
}

/// Junction between a schedule slot and a TeacherMaterial — lets a
/// teacher attach materials (PDFs, slides, links) to a SPECIFIC date
/// occurrence of a recurring period (e.g. "math class on May 24" gets a
/// PDF that doesn't show up for math class on May 17 or May 31).
///
/// `date` is the YYYY-MM-DD the attachment applies to. The empty
/// string "" is reserved for legacy attachments created before
/// date-scoping landed — those continue to apply to every occurrence
/// of the slot (existing rows from the old composite PK keep that
/// shape after db push). New attachments always carry a real date.
///
/// Owned by the slot's teacher; admins can also manage.
model ScheduleSlotMaterial {
  slotId            String
  teacherMaterialId String
  date              String   @default("")
  createdAt         DateTime @default(now())

  slot     ScheduleSlot    @relation(fields: [slotId], references: [id], onDelete: Cascade)
  material TeacherMaterial @relation(fields: [teacherMaterialId], references: [id], onDelete: Cascade)

  @@id([slotId, teacherMaterialId, date])
  @@index([teacherMaterialId])
  @@index([slotId, date])
}

/// Photos/files attached to a schedule period by ANY participant (students
/// AND teachers) — a shared, class-wide "drop box" for a period, distinct
/// from the teacher's curated TeacherMaterial library. The uploader's name is
/// shown publicly. `date` is the occurrence (YYYY-MM-DD) the poster was
/// viewing, used to label the item in the "Class Materials" tab.
model ScheduleSlotStudent {
  slotId    String
  studentId String

  slot    ScheduleSlot   @relation(fields: [slotId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)

  @@id([slotId, studentId])
  @@index([studentId])
}

model ScheduleSlotCohort {
  slotId   String
  cohortId String

  slot   ScheduleSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  cohort Cohort       @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@id([slotId, cohortId])
  @@index([cohortId])
}

model SchoolPeriodDefault {
  id        String @id @default(cuid())
  schoolId  String
  period    Int
  startTime String // "08:00"
  endTime   String // "08:45"

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, period])
  @@index([schoolId])
}

model ScheduleOverride {
  id        String   @id @default(uuid())
  cohortId  String
  date      DateTime
  period    Int
  subject   String?
  teacherId String?

  cohort  Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  teacher User?  @relation("TeacherOverrides", fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([cohortId, date, period])
  @@index([cohortId, date])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model AttendanceSession {
  id        String   @id @default(uuid())
  // cohortId is set for class/cohort periods; slotId is set for periods
  // targeted by grade or individual students (no cohort to key on). Exactly
  // one of them keys the session.
  cohortId  String?
  slotId    String?
  date      DateTime
  period    Int
  classNote String?

  cohort Cohort? @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  records AttendanceRecord[]

  @@unique([cohortId, date, period])
  @@unique([slotId, date, period])
  @@index([cohortId, date])
  @@index([slotId, date])
}

model AttendanceRecord {
  id        String           @id @default(uuid())
  sessionId String
  studentId String
  status    AttendanceStatus @default(PRESENT)
  note      String?

  // ✅ NEW: event time + change time (for unread + ordering)
  markedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student StudentProfile    @relation(fields: [studentId], references: [userId], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@index([sessionId])
  @@index([markedAt])
  @@index([studentId, markedAt])
}

model Assessment {
  id        String   @id @default(uuid())
  /// Nullable: a grade can be recorded for a student who belongs to no cohort
  /// (e.g. a one-off "Other" grade). GradeRecord links student→assessment
  /// directly, so cohortId is metadata only and may be null.
  cohortId  String?
  title     String
  subject   String?
  date      DateTime
  maxGrade  Int      @default(100)
  createdBy String // teacher user id

  examId              String?
  teacherAssignmentId String?
  published           Boolean @default(true)

  cohort            Cohort?            @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  teacher           User               @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  exam              TeacherExam?       @relation(fields: [examId], references: [id], onDelete: SetNull)
  teacherAssignment TeacherAssignment? @relation(fields: [teacherAssignmentId], references: [id], onDelete: SetNull)

  grades GradeRecord[]

  @@index([cohortId])
  @@index([createdBy])
  @@index([examId])
  @@index([teacherAssignmentId])
}

model GradeRecord {
  id           String  @id @default(uuid())
  assessmentId String
  studentId    String
  grade        Int
  comment      String?

  assessment Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student    StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)

  @@unique([assessmentId, studentId])
  @@index([studentId])
}

model ParentLinkCode {
  id        String   @id @default(uuid())
  childId   String
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  child User @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@index([expiresAt])
}

model ParentNotification {
  id        String    @id @default(uuid())
  parentId  String
  studentId String?
  type      String
  title     String
  message   String?
  data      Json?
  createdAt DateTime  @default(now())
  seenAt    DateTime?

  parent User @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([parentId, createdAt])
  @@index([parentId, seenAt])
  @@index([studentId, createdAt])
}

model ParentNotificationState {
  id         String   @id @default(uuid())
  parentId   String   @unique
  lastSeenAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  parent User @relation(fields: [parentId], references: [id], onDelete: Cascade)
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  body      String
  createdBy String
  createdAt DateTime @default(now())

  publishAt DateTime  @default(now())
  expiresAt DateTime?
  pinned    Boolean   @default(false)

  /// File / link attachments, same shape as ClassroomMaterial.attachments:
  /// `[{ type: "file"|"link"|"image", url, name, mime? }, …]`.
  attachments Json @default("[]")

  creator           User                 @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  targets           AnnouncementTarget[]
  announcementSeens AnnouncementSeen[]

  @@index([publishAt])
  @@index([expiresAt])
  @@index([pinned])
  @@index([createdBy])
}

model AnnouncementTarget {
  id             String @id @default(uuid())
  announcementId String

  // Target selectors (any of these can be used)
  userId   String?
  role     Role?
  grade    Int?
  cohortId String?

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@index([announcementId])
  @@index([userId])
  @@index([role])
  @@index([grade])
  @@index([cohortId])
}

model AnnouncementSeen {
  id             String   @id @default(uuid())
  userId         String
  announcementId String
  seenAt         DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([userId, announcementId])
  @@index([userId])
  @@index([announcementId])
}

model AlertSettings {
  id        String @id @default(uuid())
  ownerId   String
  studentId String

  minGrade    Int @default(70)
  maxAbsences Int @default(1)
  maxLates    Int @default(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, studentId])
  @@index([studentId])
  @@index([ownerId])
}

//
// --- Day 1 foundation: materials + learning profile + AI brain + tutor memory + analytics ---
//

enum MaterialSource {
  BAGRUT
  TEACHER
  BOOK
  OTHER
}

enum TutorMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AnalyticsActorRole {
  STUDENT
  PARENT
  TEACHER
  SECRETARY
  ADMIN
}

model Material {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // scoping
  cohortId String?

  // content
  title    String
  subject  String? // e.g. MATH/PHYSICS/CS
  grade    Int? // bagrut target grade (10/11/12)
  language String? // 'he'/'ar'/'en'
  source   MaterialSource @default(BAGRUT)

  // "chunk" style storage (start simple: full text)
  content String

  // loose tags for retrieval
  tags String[] @default([])

  @@index([cohortId])
  @@index([subject])
}

model LearningProfile {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // userId = student user id
  userId String @unique

  // "bagrut level" guardrails
  targetCurriculum  String? // 'bagrut'
  targetGrade       Int? // 10/11/12
  preferredLanguage String? // 'he'/'ar'/'en'

  // style matching (how tutor behaves)
  tone         String? // e.g. "friendly", "strict", "funny"
  verbosity    Int? // 1-10
  explainStyle String? // e.g. "step-by-step", "short hints", "use examples"
  emojiOk      Boolean @default(true)

  // learning state
  strengths  String[] @default([])
  weaknesses String[] @default([])
  goals      String[] @default([])

  // guardrail: avoid advanced topics
  maxDepth Int? // 1=very basic ... 5=advanced (we keep <=3 for bagrut by default)
}

model StudentBrainSnapshot {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId   String // student user id
  cohortId String?

  // compact analytics summary the tutor can read
  // (keep JSON flexible, schema later)
  metrics Json

  // example metrics you might store inside JSON:
  // { "math": {"avg": 78,"trend":"up","weak":["quadratic"],"strong":["trig"]}, ... }

  @@index([userId, createdAt])
  @@index([cohortId])
}

enum BrainEventType {
  CHAT_MESSAGE
  QUIZ_ATTEMPT
  QUIZ_RESULT
  MISTAKE
  HINT_USED
  CONCEPT_EXPLAINED
  CONFUSION
  PREFERENCE
}

enum BrainSkillStatus {
  UNKNOWN
  LEARNING
  OK
  STRONG
}

model StudentBrainProfile {
  id                String  @id @default(uuid())
  studentId         String  @unique
  // lightweight learning prefs (used in prompt injection)
  preferredLanguage String? // "en" | "ar" | "he"
  verbosity         String? // "concise" | "normal" | "detailed"
  quizFrequency     String? // "low" | "medium" | "high"
  tone              String? // "friendly" | "strict" | "coach"
  humor             String? // "none" | "light" | "more"
  addressName       String? // "first" | "full" | "none"

  // optional: stable baseline about the student (short)
  baselineSummary String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)

  @@index([studentId])
}

model StudentBrainSkill {
  id         String           @id @default(uuid())
  studentId  String
  subject    String
  topic      String
  status     BrainSkillStatus @default(UNKNOWN)
  strength   Int              @default(0) // 0..100 (simple scalar for now)
  lastSeenAt DateTime?

  evidenceCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)

  @@unique([studentId, subject, topic])
  @@index([studentId, subject])
}

model StudentBrainEvent {
  id             String         @id @default(uuid())
  studentId      String
  type           BrainEventType
  subject        String?
  topic          String?
  // short JSON-ish payload stored as string (keeps v1 simple, avoids jsonb migrations)
  payload        String?
  // optional linkage to tutor session/message
  tutorSessionId String?
  tutorMessageId String?

  createdAt DateTime @default(now())

  student StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  session TutorSession?  @relation(fields: [tutorSessionId], references: [id], onDelete: SetNull)
  message TutorMessage?  @relation(fields: [tutorMessageId], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
  @@index([tutorSessionId])
}

model StudentBrainSummary {
  id        String @id @default(uuid())
  studentId String @unique

  // rolling prompt context (short, cached)
  summary String

  // bookkeeping for refresh cadence
  lastEventAt DateTime?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  student StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)

  @@index([studentId])
}

model TutorSession {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  characterId String?
  character   TutorCharacter? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  updatedAt   DateTime        @updatedAt

  userId   String // student user id
  cohortId String?

  // optional title/topic
  title String?
  topic String?

  messages    TutorMessage[]
  brainEvents StudentBrainEvent[]

  @@index([userId, updatedAt])
  @@index([cohortId])
}

model TutorMessage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  sessionId String
  role      TutorMessageRole
  content   String

  // what tutor used as sources (ids or short refs)
  sources String[] @default([])

  session     TutorSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  brainEvents StudentBrainEvent[]

  @@index([sessionId, createdAt])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  actorUserId String?
  actorRole   AnalyticsActorRole?

  // scope
  cohortId  String?
  studentId String?

  // event
  name    String
  payload Json?

  @@index([name, createdAt])
  @@index([cohortId])
  @@index([studentId])
}

enum TutorCharacterSubject {
  GENERAL
  MATH
  PHYSICS
  CS
  ENGLISH
  HEBREW
  ARABIC
}

model TutorCharacter {
  id          String   @id @default(cuid())
  createdById String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // scope (optional) – later we can make per cohort/school
  cohortId String?

  subject      TutorCharacterSubject @default(GENERAL)
  name         String // e.g. "Mr. Derivative", "Physics Coach"
  // how it speaks/behaves (high-level; real behavior comes later from AI brain + profile)
  tone         String? // friendly/strict/etc.
  verbosity    Int? // 1-10
  explainStyle String? // step-by-step / hints / examples

  // guardrails
  curriculum String? // e.g. "bagrut"
  maxGrade   Int? // 10/11/12
  language   String? // he/ar/en

  // later: prompt template / system rules
  systemNotes String? // short instruction block

  sessions TutorSession[]

  @@unique([cohortId, subject, name])
  @@index([cohortId])
  @@index([subject])
  @@index([cohortId, subject])
  @@index([isPublic, subject])
}

model TutorReplyCache {
  id                 String   @id @default(cuid())
  userId             String
  characterId        String?
  normalizedQuestion String
  topic              String?
  mode               String // "deterministic" | "llm"
  content            String
  refs               String?
  excerpt            String?
  createdAt          DateTime @default(now())
  expiresAt          DateTime

  @@unique([userId, characterId, normalizedQuestion, mode])
  @@index([userId, characterId])
}

// ### CLASSMATE:MODELS:BEGIN
model Solution {
  id             String   @id @default(uuid())
  authorId       String
  subject        String // "math" | "physics" | ...
  sourceType     String // "book" | "bagrut" | "other"
  sourceName     String? // book name OR bagrut year/season
  page           Int?
  questionNumber String? // "12" or "12a"
  title          String?
  notes          String?
  body           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  author User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  images SolutionImage[]

  likes    SolutionLike[]
  reposts  SolutionRepost[]
  comments SolutionComment[]

  @@unique([createdAt, id])
  @@index([createdAt])
  @@index([subject, sourceType])
  @@index([subject, sourceName, page])
  @@index([subject, sourceName, page, questionNumber])
  @@index([createdAt, id])
}

model SolutionImage {
  id         String @id @default(uuid())
  solutionId String

  // public URL (served from /uploads)
  url String

  // storage + metadata (for PDFs/scans/search)
  storagePath  String
  kind         String // "image" | "pdf" | "other"
  mime         String
  sizeBytes    Int
  originalName String?
  sha256       String?

  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  solution Solution @relation(fields: [solutionId], references: [id], onDelete: Cascade)

  @@index([solutionId])
  @@index([kind])
  @@index([mime])
  @@index([sha256])
}

model SolutionLike {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  solutionId String
  userId     String

  solution Solution @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([solutionId, userId])
  @@index([solutionId])
  @@index([userId])
}

model SolutionRepost {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  solutionId String
  userId     String

  solution Solution @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([solutionId, userId])
  @@index([solutionId])
  @@index([userId])
}

model SolutionComment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  body      String

  solutionId String
  authorId   String

  solution Solution @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([solutionId, createdAt])
  @@index([authorId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  data      Json?
  severity  String    @default("info") // info|success|warning|error
  seenAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, seenAt])
}

// A device-level FCM/APNs token. One row per (token, userId) pair so a
// shared device that logs in as multiple accounts gets fan-out to whoever
// is currently signed in. We dedupe on `token` alone (a single physical
// device only has one current token) and overwrite the userId when the
// account on the device changes. NotificationsHubService.notify() reads
// from here to send outside-the-app pushes alongside the SSE push.
model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String   // 'ios' | 'android'
  appVersion String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ### CLASSMATE:MODELS:END

// ---- Session 10: School subject defaults + per-student overrides ----
model SchoolGradeSubjectDefault {
  id           String   @id @default(cuid())
  schoolId     String
  grade        Int
  /// Legacy flat name list — kept in sync with `subjectsI18n[*].nameEn` for
  /// backward compatibility with older clients still reading a String[].
  subjects     String[]
  /// Authoritative source. Array of { nameEn, nameAr?, nameHe?, nameFr?, nameRu? }.
  subjectsI18n Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([schoolId, grade], name: "schoolId_grade_unique")
  @@index([schoolId])
}

model StudentSubjectOverride {
  id        String   @id @default(cuid())
  userId    String
  enabled   Boolean  @default(true)
  subjects  String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId])
  @@index([userId])
}

enum ScheduleTemplateKind {
  GRADE
  MAJOR
  COHORT
  STUDENT
}

model ScheduleTemplate {
  id       String               @id @default(uuid())
  schoolId String
  kind     ScheduleTemplateKind
  name     String

  // optional targeting keys (only used depending on kind)
  grade   Int?
  section Int?
  major   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slots        ScheduleTemplateSlot[]
  cohortBinds  CohortScheduleTemplate[]
  studentBinds StudentScheduleTemplate[]

  @@index([schoolId, kind])
  @@index([schoolId, grade, section])
  @@index([schoolId, major])
}

model ScheduleTemplateSlot {
  id         String  @id @default(uuid())
  templateId String
  dayOfWeek  Int // 0=Sun..6=Sat
  period     Int // 1..10
  teacherId  String?
  location   String?

  template ScheduleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  teacher  User?            @relation("TeacherSlots", fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([templateId, dayOfWeek, period])
  @@index([templateId, dayOfWeek, period])
}

model CohortScheduleTemplate {
  id         String @id @default(uuid())
  cohortId   String
  templateId String
  priority   Int    @default(50) // lower = higher priority among same binding type

  cohort   Cohort           @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  template ScheduleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([cohortId, templateId])
  @@index([cohortId, priority])
  @@index([templateId])
}

model StudentScheduleTemplate {
  id         String @id @default(uuid())
  studentId  String
  templateId String
  priority   Int    @default(10) // student bindings should beat cohort by default

  student  User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  template ScheduleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([studentId, templateId])
  @@index([studentId, priority])
  @@index([templateId])
}

// ── Classroom (teacher-created, like Google Classroom) ────────────────────────
model Classroom {
  id        String   @id @default(cuid())
  name      String
  subject   String
  teacherId String
  schoolId  String?
  // Short, unique, human-typable join code (e.g. "K7M4QP"). Replaces the old
  // approach of deriving a code from the first 6 chars of the cuid id — those
  // collided across classrooms created in the same window (cuids share a
  // timestamp prefix). Nullable for legacy rows; lazily generated on first
  // teacher fetch.
  joinCode  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher     User                  @relation("TeacherClassrooms", fields: [teacherId], references: [id], onDelete: Cascade)
  school      School?               @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  members     ClassroomMember[]
  messages    ClassroomMessage[]
  assignments ClassroomAssignment[]
  materials   ClassroomMaterial[]
  meetings    ClassroomMeeting[]
  slots       ScheduleSlot[]

  @@index([teacherId])
  @@index([schoolId])
}

model ClassroomMember {
  classroomId String
  studentId   String
  joinedAt    DateTime @default(now())

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  student   User      @relation("ClassroomMemberships", fields: [studentId], references: [id], onDelete: Cascade)

  @@id([classroomId, studentId])
  @@index([studentId])
}

// Chat: WhatsApp-like messages
model ClassroomMessage {
  id           String               @id @default(cuid())
  classroomId  String
  senderUserId String
  kind         ClassroomMessageKind @default(TEXT)
  text         String?
  mediaUrl     String?
  mediaMime    String?
  durationSec  Int?
  createdAt    DateTime             @default(now())

  replyToMessageId  String?
  replyToSenderName String?
  replyToText       String?

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@index([classroomId, createdAt])
  @@index([senderUserId, createdAt])
}

enum ClassroomMessageKind {
  TEXT
  VOICE
  IMAGE
  DOC
}

model ClassroomAssignment {
  id                  String    @id @default(cuid())
  classroomId         String
  title               String
  body                String?
  dueAt               DateTime?
  createdBy           String
  teacherAssignmentId String? // back-ref to TeacherAssignment mirror
  attachments         Json      @default("[]")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  classroom   Classroom              @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]

  @@index([classroomId, createdAt])
  @@index([classroomId, dueAt])
}

model AssignmentSubmission {
  id           String   @id @default(cuid())
  assignmentId String
  studentId    String
  note         String?
  files        Json     @default("[]")
  submittedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignment ClassroomAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User                @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
}

model ClassroomMaterial {
  id                String   @id @default(cuid())
  classroomId       String
  title             String
  description       String?
  url               String
  attachments       Json     @default("[]")
  mime              String?
  createdBy         String
  teacherMaterialId String? // back-ref to the TeacherMaterial that created this mirror
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@index([classroomId, createdAt])
}

model ClassroomMeeting {
  id               String    @id @default(cuid())
  classroomId      String
  title            String
  startsAt         DateTime
  endsAt           DateTime?
  link             String
  createdBy        String
  teacherMeetingId String? // back-ref to TeacherMeeting mirror
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@index([classroomId, startsAt])
  @@index([classroomId, createdAt])
}

model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  type        String
  aggregateId String?   @map("aggregate_id") @db.Uuid
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at")
  availableAt DateTime  @default(now()) @map("available_at")
  processedAt DateTime? @map("processed_at")
  failedAt    DateTime? @map("failed_at")
  retryCount  Int       @default(0) @map("retry_count")
  error       String?

  @@index([processedAt, availableAt, createdAt], map: "idx_outbox_process_queue")
  @@index([type, createdAt], map: "idx_outbox_type_created_at")
  @@map("outbox_events")
}

model FeedSolutionCard {
  solutionId      String   @id @map("solution_id") @db.Uuid
  schoolId        String   @map("school_id") @db.Uuid
  classId         String?  @map("class_id") @db.Uuid
  authorId        String   @map("author_id") @db.Uuid
  authorName      String   @map("author_name")
  subject         String
  sourceType      String   @map("source_type")
  sourceName      String?  @map("source_name")
  page            Int?
  questionNumber  String?  @map("question_number")
  title           String?
  bodyPreview     String?  @map("body_preview")
  primaryImageUrl String?  @map("primary_image_url")
  imageCount      Int      @default(0) @map("image_count")
  likeCount       Int      @default(0) @map("like_count")
  commentCount    Int      @default(0) @map("comment_count")
  repostCount     Int      @default(0) @map("repost_count")
  rankingScore    Float    @default(0) @map("ranking_score")
  teacherPick     Boolean  @default(false) @map("teacher_pick")
  bestSolution    Boolean  @default(false) @map("best_solution")
  difficulty      String?
  createdAt       DateTime @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([schoolId, rankingScore(sort: Desc), createdAt(sort: Desc)], map: "idx_feed_solution_cards_school_rank_created")
  @@index([schoolId, subject, rankingScore(sort: Desc)], map: "idx_feed_solution_cards_school_subject_rank")
  @@index([schoolId, sourceName, page, questionNumber], map: "idx_feed_solution_cards_lookup")
  @@map("feed_solution_cards")
}

model ClassroomPreviewCard {
  classroomId       String    @id @map("classroom_id") @db.Uuid
  schoolId          String?   @map("school_id") @db.Uuid
  title             String
  subject           String?
  latestMessageText String?   @map("latest_message_text")
  latestMessageAt   DateTime? @map("latest_message_at")
  latestSenderName  String?   @map("latest_sender_name")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([schoolId, latestMessageAt(sort: Desc)], map: "idx_classroom_preview_cards_school_latest")
  @@map("classroom_preview_cards")
}

model ClassroomUserCounter {
  id                String    @id @default(uuid()) @db.Uuid
  classroomId       String    @map("classroom_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  unreadCount       Int       @default(0) @map("unread_count")
  lastSeenMessageId String?   @map("last_seen_message_id") @db.Uuid
  lastSeenAt        DateTime? @map("last_seen_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([classroomId, userId], map: "uq_classroom_user_counters_classroom_user")
  @@index([userId, unreadCount(sort: Desc)], map: "idx_classroom_user_counters_user_unread")
  @@map("classroom_user_counters")
}

model WeeklySolverLeaderboard {
  id                   String @id @default(uuid()) @db.Uuid
  schoolId             String @map("school_id") @db.Uuid
  weekKey              String @map("week_key")
  userId               String @map("user_id") @db.Uuid
  userName             String @map("user_name")
  solutionCount        Int    @default(0) @map("solution_count")
  likeCountReceived    Int    @default(0) @map("like_count_received")
  commentCountReceived Int    @default(0) @map("comment_count_received")
  repostCountReceived  Int    @default(0) @map("repost_count_received")
  score                Float  @default(0)

  @@unique([schoolId, weekKey, userId], map: "uq_weekly_solver_leaderboard_school_week_user")
  @@index([schoolId, weekKey, score(sort: Desc)], map: "idx_weekly_solver_leaderboard_rank")
  @@map("weekly_solver_leaderboard")
}

model BagrutQuestion {
  id            String @id @default(cuid())
  subject       String
  topicLabel    String
  year          Int
  season        String
  examCode      String
  questionIndex Int

  promptLatex   String
  solutionLatex String

  difficulty String
  points     Int

  createdAt DateTime @default(now())
}

enum SolutionModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SolutionVerificationStatus {
  UNCHECKED
  VERIFIED
  REJECTED
}

// PENDING  — newly filed, awaiting an admin decision
// APPROVED — admin reviewed and kept the solution (report dismissed)
// REMOVED  — admin removed the solution (it is soft-deleted)
enum SolutionReportStatus {
  PENDING
  APPROVED
  REMOVED
}

model SolutionBook {
  id        String   @id @default(cuid())
  subject   String
  title     String
  slug      String?
  // Number of pages in the book — set by the admin/teacher who creates it.
  pages     Int      @default(0)
  // Optional cover image URL (served from /uploads), set on create/edit.
  coverUrl  String?
  createdAt DateTime @default(now())

  solutions SolutionUpload[]

  @@unique([subject, title])
  @@index([subject])
}

// A student-filed report against a solution. Reaches the admins of BOTH
// involved schools (the reporter's and the poster's). Admins view the whole
// thing and either APPROVE (keep) or REMOVE (soft-delete the solution).
model SolutionReport {
  id           String               @id @default(cuid())
  uploadId     String
  reporterId   String
  reason       String?
  status       SolutionReportStatus @default(PENDING)
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime             @default(now())

  upload SolutionUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([uploadId])
  @@index([status, createdAt])
  @@index([reporterId])
}

model SolutionUpload {
  id                 String                     @id @default(cuid())
  userId             String
  subject            String
  bookId             String
  caption            String?
  pageNumber         Int
  questionNumber     String
  uploaderName       String?
  uploaderInitials   String?
  moderationStatus   SolutionModerationStatus   @default(PENDING)
  verificationStatus SolutionVerificationStatus @default(UNCHECKED)
  moderationReason   String?
  verificationNote   String?
  isDeleted          Boolean                    @default(false)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  book    SolutionBook         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  files   SolutionUploadFile[]
  reports SolutionReport[]

  @@index([userId, createdAt])
  @@index([subject, pageNumber, createdAt])
  @@index([subject, bookId, pageNumber, questionNumber])
  @@index([bookId])
}

model SolutionUploadFile {
  id        String   @id @default(cuid())
  uploadId  String
  kind      String
  url       String
  mimeType  String?
  fileName  String?
  fileSize  Int?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  upload SolutionUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([uploadId, sortOrder])
}

model PracticeAttempt {
  id            String   @id @default(cuid())
  userId        String
  sessionId     String?
  subject       String
  topicLabel    String
  mode          String
  difficulty    String
  questionId    String
  prompt        String
  selectedIndex Int?
  correctIndex  Int
  isCorrect     Boolean
  timeTakenMs   Int?
  awardedScore  Int      @default(0)
  usedNova      Boolean  @default(false)
  source        String   @default("ai")
  createdAt     DateTime @default(now())

  @@index([userId, sessionId, createdAt])
  @@index([userId, subject, topicLabel, createdAt])
  @@index([userId, createdAt])
}

model PracticeSkillProfile {
  id           String   @id @default(cuid())
  userId       String
  subject      String
  topicLabel   String
  theta        Float    @default(0)
  uncertainty  Float    @default(1)
  streak       Int      @default(0)
  totalSeen    Int      @default(0)
  totalCorrect Int      @default(0)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@unique([userId, subject, topicLabel])
  @@index([userId, subject, updatedAt])
}

enum DmThreadType {
  DIRECT
  GROUP
}

enum DmParticipantRole {
  MEMBER
  ADMIN
}

enum DmParticipantState {
  PENDING_INCOMING
  PENDING_OUTGOING
  ACCEPTED
  BLOCKED
}

enum DmMessageKind {
  TEXT
  IMAGE
  VOICE
  VIDEO
  FILE
}

enum DmMediaMode {
  ONCE
  REPLAY
  KEEP
}

enum DmMessageDeleteMode {
  VISIBLE
  DELETED_FOR_ME
  DELETED_FOR_EVERYONE
  MODERATOR_REMOVED
}

model DmThread {
  id           String          @id @default(cuid())
  type         DmThreadType    @default(DIRECT)
  title        String?
  inviteCode   String?         @unique
  createdById  String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  participants DmParticipant[]
  messages     DmMessage[]
}

model DmParticipant {
  id         String             @id @default(cuid())
  threadId   String
  userId     String
  role       DmParticipantRole  @default(MEMBER)
  state      DmParticipantState @default(ACCEPTED)
  isMuted    Boolean            @default(false)
  lastSeenAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  thread     DmThread           @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([userId, state])
}

model DmMessage {
  id               String              @id @default(cuid())
  threadId         String
  senderId         String
  kind             DmMessageKind       @default(TEXT)
  text             String?
  mediaUrl         String?
  mediaMimeType    String?
  replyToMessageId String?
  mediaMode        DmMediaMode?
  viewLimit        Int?
  replayLimit      Int?
  expiresAt        DateTime?
  isPinned         Boolean             @default(false)
  editedAt         DateTime?
  deletedAt        DateTime?
  deleteMode       DmMessageDeleteMode @default(VISIBLE)
  forwardedFromId  String?
  createdAt        DateTime            @default(now())
  thread           DmThread            @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender           User                @relation("DmMessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  views            DmMessageView[]
  reactions        DmReaction[]
  replyTo          DmMessage?          @relation("DmMessageReply", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          DmMessage[]         @relation("DmMessageReply")
  forwardedFrom    DmMessage?          @relation("DmMessageForward", fields: [forwardedFromId], references: [id], onDelete: SetNull)
  forwardedCopies  DmMessage[]         @relation("DmMessageForward")
  reports          DmMessageReport[]

  @@index([threadId, createdAt])
  @@index([replyToMessageId])
  @@index([forwardedFromId])
}

model DmMessageView {
  id          String    @id @default(cuid())
  messageId   String
  viewerId    String
  viewedAt    DateTime  @default(now())
  replayCount Int       @default(0)
  message     DmMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, viewerId])
}

model DmReaction {
  id        String    @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime  @default(now())
  message   DmMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model MessageThread {
  id                  String              @id @default(uuid())
  type                MessageThreadType
  title               String?
  createdByUserId     String
  requestState        MessageRequestState @default(NONE)
  requestTargetUserId String?
  requestDecisionById String?
  requestDecisionAt   DateTime?
  lastMessageAt       DateTime?
  groupAvatarUrl      String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  createdBy         User                  @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  requestDecisionBy User?                 @relation("MessageRequestDecisionUser", fields: [requestDecisionById], references: [id], onDelete: SetNull)
  members           MessageThreadMember[]
  messages          Message[]

  @@index([createdByUserId])
  @@index([requestTargetUserId])
  @@index([requestState])
  @@index([lastMessageAt])
}

model MessageThreadMember {
  id                String    @id @default(uuid())
  threadId          String
  userId            String
  role              String    @default("MEMBER")
  joinedAt          DateTime  @default(now())
  lastReadMessageId String?
  lastReadAt        DateTime?
  isArchived        Boolean   @default(false)
  isMuted           Boolean   @default(false)
  isBlocked         Boolean   @default(false)

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([userId])
  @@index([threadId, lastReadAt])
}

model Message {
  id                String            @id @default(uuid())
  threadId          String
  senderId          String
  kind              MessageKind       @default(TEXT)
  text              String            @default("")
  mediaUrl          String?
  mediaMime         String?
  originalFileName  String?
  replyToMessageId  String?
  forwardedFromId   String?
  editedAt          DateTime?
  deleteMode        MessageDeleteMode @default(NONE)
  deletedForUserIds String[]          @default([])
  createdAt         DateTime          @default(now())

  thread          MessageThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender          User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo         Message?          @relation("MessageReply", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies         Message[]         @relation("MessageReply")
  forwardedFrom   Message?          @relation("MessageForward", fields: [forwardedFromId], references: [id], onDelete: SetNull)
  forwardedCopies Message[]         @relation("MessageForward")
  reactions       MessageReaction[]

  @@index([threadId, createdAt])
  @@index([senderId, createdAt])
  @@index([replyToMessageId])
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([userId, createdAt])
}

enum MessageReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

/// User-filed report on a DM/group chat message. Required by Google Play
/// policy for any app with user-to-user messaging. Admins triage these in
/// the Admin → Reports screen.
model DmMessageReport {
  id         String              @id @default(uuid())
  messageId  String
  reporterId String
  reason     String? // optional free-text "why"
  status     MessageReportStatus @default(OPEN)
  createdAt  DateTime            @default(now())
  resolvedAt DateTime?
  resolvedBy String? // admin user id

  message  DmMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporter User      @relation("DmMessageReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([messageId, reporterId]) // one report per user per message
  @@index([status, createdAt])
}

model SchoolForm {
  id                     String    @id @default(uuid())
  schoolId               String
  createdBy              String
  title                  String
  description            String?
  subject                String?
  audienceLabel          String?
  acceptingResponses     Boolean   @default(true)
  allowMultipleResponses Boolean   @default(false)
  published              Boolean   @default(false)
  publishedAt            DateTime?
  questions              Json      @default("[]")
  targetType             String    @default("EVERYONE")
  targetCohortIds        String[]  @default([])
  targetStudentIds       String[]  @default([])
