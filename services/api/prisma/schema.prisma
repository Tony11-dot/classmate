generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
  PARENT
  SECRETARY
}

enum AccountStatus {
  AUTH_ONLY
  PENDING
  ACTIVE
}

enum ParentChildStatus {
  PENDING
  APPROVED
}

model User {
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  password                String
  name                    String
  parentNotificationState ParentNotificationState?

  // NEW: identity/profile
  displayName String?
  legalName   String?
  phone       String?
  status      AccountStatus @default(AUTH_ONLY)

  // optional future tzfonet fields
  tzfonetEmail      String?
  tzfonetVerifiedAt DateTime?

  roles          UserRole[]
  studentProfile StudentProfile?

  // parent-child links
  parentLinks ParentChild[] @relation("ParentLinks")
  childLinks  ParentChild[] @relation("ChildLinks")

  // back-relation for teacher-owned courses
  taughtCourses Course[] @relation("TeacherCourses")

  createdAt           DateTime             @default(now())
  assessments         Assessment[]
  parentLinkCodes     ParentLinkCode[]
  announcements       Announcement[]
  announcementSeens   AnnouncementSeen[]
  parentNotifications ParentNotification[]
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  role   Role
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

model Cohort {
  id    String @id @default(uuid())
  name  String @unique // e.g. "10th-2"
  grade Int // 7..12

  students           StudentProfile[]
  courses            Course[]
  scheduleSlots      ScheduleSlot[]
  joinCodes          CohortJoinCode[]
  scheduleOverrides  ScheduleOverride[]
  attendanceSessions AttendanceSession[]
}

model CohortJoinCode {
  id        String    @id @default(uuid())
  cohortId  String
  codeHash  String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@index([cohortId])
}

model StudentProfile {
  userId       String @id
  cohortId     String
  englishLevel Int
  mathLevel    Int

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohort            Cohort             @relation(fields: [cohortId], references: [id])
  studentMajors     StudentMajor[]
  enrollments       Enrollment[]
  attendanceRecords AttendanceRecord[]
  gradeRecords      GradeRecord[]

  @@index([cohortId])
}

model ParentChild {
  id       String            @id @default(uuid())
  parentId String
  childId  String
  status   ParentChildStatus @default(APPROVED)

  parent User @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)
  child  User @relation("ChildLinks", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId])
  @@index([parentId])
  @@index([childId])
}

enum CourseRuleType {
  COHORT
  ENGLISH_LEVEL
  MATH_LEVEL
  MAJOR_REQUIRED
  ELECTIVE_OPT_IN
}

enum EnrollmentSource {
  AUTO
  MANUAL
}

model Major {
  id   String @id @default(uuid())
  name String @unique

  students StudentMajor[]
}

model StudentMajor {
  id        String @id @default(uuid())
  studentId String
  majorId   String

  student StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  major   Major          @relation(fields: [majorId], references: [id], onDelete: Cascade)

  @@unique([studentId, majorId])
  @@index([majorId])
}

model Course {
  id        String  @id @default(uuid())
  name      String
  subject   String
  teacherId String?

  cohortId String?
  groupTag String?

  teacher User?   @relation("TeacherCourses", fields: [teacherId], references: [id])
  cohort  Cohort? @relation(fields: [cohortId], references: [id])

  rules              CourseRule[]
  slots              ScheduleSlot[]
  enrollments        Enrollment[]
  scheduleOverrides  ScheduleOverride[]
  attendanceSessions AttendanceSession[]
  assessments        Assessment[]

  @@index([teacherId])
  @@index([cohortId])
}

model CourseRule {
  id       String         @id @default(uuid())
  courseId String
  type     CourseRuleType
  value    String

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model Enrollment {
  id        String           @id @default(uuid())
  courseId  String
  studentId String
  source    EnrollmentSource @default(AUTO)

  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@index([studentId])
}

model ScheduleSlot {
  id        String  @id @default(uuid())
  cohortId  String
  dayOfWeek Int
  period    Int
  courseId  String?

  cohort Cohort  @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id])

  @@unique([cohortId, dayOfWeek, period])
  @@index([courseId])
}

model ScheduleOverride {
  id       String   @id @default(uuid())
  cohortId String
  date     DateTime // midnight UTC is fine; we'll treat as date in Asia/Jerusalem
  period   Int
  courseId String?

  cohort Cohort  @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id])

  @@unique([cohortId, date, period])
  @@index([courseId])
  @@index([cohortId, date])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model AttendanceSession {
  id       String   @id @default(uuid())
  cohortId String
  date     DateTime
  period   Int
  courseId String?

  cohort Cohort  @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id])

  records AttendanceRecord[]

  @@unique([cohortId, date, period])
  @@index([courseId])
  @@index([cohortId, date])
}

model AttendanceRecord {
  id        String           @id @default(uuid())
  sessionId String
  studentId String
  status    AttendanceStatus @default(PRESENT)
  note      String?

  // ✅ NEW: event time + change time (for unread + ordering)
  markedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student StudentProfile    @relation(fields: [studentId], references: [userId], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@index([sessionId])
  @@index([markedAt])
}

model Assessment {
  id        String   @id @default(uuid())
  courseId  String
  title     String
  date      DateTime
  maxGrade  Int      @default(100)
  createdBy String // teacher user id

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher User   @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  grades GradeRecord[]

  @@index([courseId])
  @@index([createdBy])
}

model GradeRecord {
  id           String  @id @default(uuid())
  assessmentId String
  studentId    String
  grade        Int
  comment      String?

  assessment Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student    StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)

  @@unique([assessmentId, studentId])
  @@index([studentId])
}

model ParentLinkCode {
  id        String   @id @default(uuid())
  childId   String
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  child User @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@index([expiresAt])
}

model ParentNotification {
  id        String    @id @default(uuid())
  parentId  String
  studentId String?
  type      String
  title     String
  message   String?
  data      Json?
  createdAt DateTime  @default(now())
  seenAt    DateTime?

  parent User @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([parentId, createdAt])
  @@index([parentId, seenAt])
  @@index([studentId, createdAt])
}

model ParentNotificationState {
  id         String   @id @default(uuid())
  parentId   String   @unique
  lastSeenAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  parent User @relation(fields: [parentId], references: [id], onDelete: Cascade)
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  body      String
  createdBy String
  createdAt DateTime @default(now())

  publishAt DateTime  @default(now())
  expiresAt DateTime?
  pinned    Boolean   @default(false)

  creator           User                 @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  targets           AnnouncementTarget[]
  announcementSeens AnnouncementSeen[]

  @@index([publishAt])
  @@index([expiresAt])
  @@index([pinned])
  @@index([createdBy])
}

model AnnouncementTarget {
  id             String @id @default(uuid())
  announcementId String

  // Target selectors (any of these can be used)
  userId   String?
  role     Role?
  grade    Int?
  cohortId String?

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@index([announcementId])
  @@index([userId])
  @@index([role])
  @@index([grade])
  @@index([cohortId])
}

model AnnouncementSeen {
  id             String   @id @default(uuid())
  userId         String
  announcementId String
  seenAt         DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([userId, announcementId])
  @@index([userId])
  @@index([announcementId])
}

model AlertSettings {
  id        String @id @default(uuid())
  ownerId   String
  studentId String

  minGrade    Int @default(70)
  maxAbsences Int @default(1)
  maxLates    Int @default(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, studentId])
  @@index([studentId])
  @@index([ownerId])
}
