generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
  PARENT
  SECRETARY
}

enum AccountStatus {
  AUTH_ONLY
  PENDING
  ACTIVE
}

enum ParentChildStatus {
  PENDING
  APPROVED
}

model User {
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  password                String
  name                    String
  parentNotificationState ParentNotificationState?

  // NEW: identity/profile
  displayName String?
  legalName   String?
  phone       String?
  status      AccountStatus @default(AUTH_ONLY)

  // optional future tzfonet fields
  tzfonetEmail      String?
  tzfonetVerifiedAt DateTime?

  roles          UserRole[]
  studentProfile StudentProfile?

  // parent-child links
  parentLinks ParentChild[] @relation("ParentLinks")
  childLinks  ParentChild[] @relation("ChildLinks")

  // back-relation for teacher-owned courses
  taughtCourses Course[] @relation("TeacherCourses")

  createdAt             DateTime               @default(now())
  assessments           Assessment[]
  parentLinkCodes       ParentLinkCode[]
  announcements         Announcement[]
  announcementSeens     AnnouncementSeen[]
  parentNotifications   ParentNotification[]
  solutions             Solution[]
  notifications         Notification[]
  solutionLikes         SolutionLike[]
  solutionComments      SolutionComment[]
  teachingTemplateSlots ScheduleTemplateSlot[] @relation("TeacherSlots")

  studentTemplateBinds StudentScheduleTemplate[]
  solutionReposts      SolutionRepost[]
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  role   Role
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

model Cohort {
  id    String @id @default(uuid())
  name  String @unique // e.g. "10th-2"
  grade Int // 7..12

  students              StudentProfile[]
  courses               Course[]
  scheduleSlots         ScheduleSlot[]
  joinCodes             CohortJoinCode[]
  scheduleOverrides     ScheduleOverride[]
  attendanceSessions    AttendanceSession[]
  scheduleTemplateBinds CohortScheduleTemplate[]
}

model CohortJoinCode {
  id        String    @id @default(uuid())
  cohortId  String
  codeHash  String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@index([cohortId])
}

model StudentProfile {
  userId       String @id
  cohortId     String
  englishLevel Int
  mathLevel    Int

  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohort            Cohort               @relation(fields: [cohortId], references: [id])
  studentMajors     StudentMajor[]
  enrollments       Enrollment[]
  attendanceRecords AttendanceRecord[]
  gradeRecords      GradeRecord[]
  // ===== AI BRAIN (v1) =====
  brainProfile      StudentBrainProfile?
  brainSkills       StudentBrainSkill[]
  brainEvents       StudentBrainEvent[]
  brainSummary      StudentBrainSummary?

  @@index([cohortId])
}

model ParentChild {
  id       String            @id @default(uuid())
  parentId String
  childId  String
  status   ParentChildStatus @default(APPROVED)

  parent User @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)
  child  User @relation("ChildLinks", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId])
  @@index([parentId])
  @@index([childId])
}

enum CourseRuleType {
  COHORT
  ENGLISH_LEVEL
  MATH_LEVEL
  MAJOR_REQUIRED
  ELECTIVE_OPT_IN
}

enum EnrollmentSource {
  AUTO
  MANUAL
}

model Major {
  id   String @id @default(uuid())
  name String @unique

  students StudentMajor[]
}

model StudentMajor {
  id        String @id @default(uuid())
  studentId String
  majorId   String

  student StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  major   Major          @relation(fields: [majorId], references: [id], onDelete: Cascade)

  @@unique([studentId, majorId])
  @@index([majorId])
}

model Course {
  id        String  @id @default(uuid())
  name      String
  subject   String
  teacherId String?

  cohortId String?
  groupTag String?

  teacher User?   @relation("TeacherCourses", fields: [teacherId], references: [id])
  cohort  Cohort? @relation(fields: [cohortId], references: [id])

  rules              CourseRule[]
  slots              ScheduleSlot[]
  enrollments        Enrollment[]
  scheduleOverrides  ScheduleOverride[]
  attendanceSessions AttendanceSession[]
  assessments        Assessment[]
  templateSlots      ScheduleTemplateSlot[]

  messages    ClassroomMessage[]
  assignments ClassroomAssignment[]
  materials   ClassroomMaterial[]
  meetings    ClassroomMeeting[]

  @@index([teacherId])
  @@index([cohortId])
}

model CourseRule {
  id       String         @id @default(uuid())
  courseId String
  type     CourseRuleType
  value    String

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model Enrollment {
  id        String           @id @default(uuid())
  courseId  String
  studentId String
  source    EnrollmentSource @default(AUTO)

  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@index([studentId])
}

model ScheduleSlot {
  id        String  @id @default(uuid())
  cohortId  String
  dayOfWeek Int
  period    Int
  courseId  String?

  cohort Cohort  @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id])

  @@unique([cohortId, dayOfWeek, period])
  @@index([courseId])
}

model ScheduleOverride {
  id       String   @id @default(uuid())
  cohortId String
  date     DateTime // midnight UTC is fine; we'll treat as date in Asia/Jerusalem
  period   Int
  courseId String?

  cohort Cohort  @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id])

  @@unique([cohortId, date, period])
  @@index([courseId])
  @@index([cohortId, date])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model AttendanceSession {
  id       String   @id @default(uuid())
  cohortId String
  date     DateTime
  period   Int
  courseId String?

  cohort Cohort  @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id])

  records AttendanceRecord[]

  @@unique([cohortId, date, period])
  @@index([courseId])
  @@index([cohortId, date])
}

model AttendanceRecord {
  id        String           @id @default(uuid())
  sessionId String
  studentId String
  status    AttendanceStatus @default(PRESENT)
  note      String?

  // ✅ NEW: event time + change time (for unread + ordering)
  markedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student StudentProfile    @relation(fields: [studentId], references: [userId], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@index([sessionId])
  @@index([markedAt])
}

model Assessment {
  id        String   @id @default(uuid())
  courseId  String
  title     String
  date      DateTime
  maxGrade  Int      @default(100)
  createdBy String // teacher user id

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher User   @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  grades GradeRecord[]

  @@index([courseId])
  @@index([createdBy])
}

model GradeRecord {
  id           String  @id @default(uuid())
  assessmentId String
  studentId    String
  grade        Int
  comment      String?

  assessment Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student    StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)

  @@unique([assessmentId, studentId])
  @@index([studentId])
}

model ParentLinkCode {
  id        String   @id @default(uuid())
  childId   String
  codeHash  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  child User @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@index([expiresAt])
}

model ParentNotification {
  id        String    @id @default(uuid())
  parentId  String
  studentId String?
  type      String
  title     String
  message   String?
  data      Json?
  createdAt DateTime  @default(now())
  seenAt    DateTime?

  parent User @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([parentId, createdAt])
  @@index([parentId, seenAt])
  @@index([studentId, createdAt])
}

model ParentNotificationState {
  id         String   @id @default(uuid())
  parentId   String   @unique
  lastSeenAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  parent User @relation(fields: [parentId], references: [id], onDelete: Cascade)
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  body      String
  createdBy String
  createdAt DateTime @default(now())

  publishAt DateTime  @default(now())
  expiresAt DateTime?
  pinned    Boolean   @default(false)

  creator           User                 @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  targets           AnnouncementTarget[]
  announcementSeens AnnouncementSeen[]

  @@index([publishAt])
  @@index([expiresAt])
  @@index([pinned])
  @@index([createdBy])
}

model AnnouncementTarget {
  id             String @id @default(uuid())
  announcementId String

  // Target selectors (any of these can be used)
  userId   String?
  role     Role?
  grade    Int?
  cohortId String?

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@index([announcementId])
  @@index([userId])
  @@index([role])
  @@index([grade])
  @@index([cohortId])
}

model AnnouncementSeen {
  id             String   @id @default(uuid())
  userId         String
  announcementId String
  seenAt         DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([userId, announcementId])
  @@index([userId])
  @@index([announcementId])
}

model AlertSettings {
  id        String @id @default(uuid())
  ownerId   String
  studentId String

  minGrade    Int @default(70)
  maxAbsences Int @default(1)
  maxLates    Int @default(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, studentId])
  @@index([studentId])
  @@index([ownerId])
}

//
// --- Day 1 foundation: materials + learning profile + AI brain + tutor memory + analytics ---
//

enum MaterialSource {
  BAGRUT
  TEACHER
  BOOK
  OTHER
}

enum TutorMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AnalyticsActorRole {
  STUDENT
  PARENT
  TEACHER
  SECRETARY
  ADMIN
}

model Material {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // scoping
  cohortId String?
  courseId String?

  // content
  title    String
  subject  String? // e.g. MATH/PHYSICS/CS
  grade    Int? // bagrut target grade (10/11/12)
  language String? // 'he'/'ar'/'en'
  source   MaterialSource @default(BAGRUT)

  // "chunk" style storage (start simple: full text)
  content String

  // loose tags for retrieval
  tags String[] @default([])

  @@index([cohortId])
  @@index([courseId])
  @@index([subject])
}

model LearningProfile {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // userId = student user id
  userId String @unique

  // "bagrut level" guardrails
  targetCurriculum  String? // 'bagrut'
  targetGrade       Int? // 10/11/12
  preferredLanguage String? // 'he'/'ar'/'en'

  // style matching (how tutor behaves)
  tone         String? // e.g. "friendly", "strict", "funny"
  verbosity    Int? // 1-10
  explainStyle String? // e.g. "step-by-step", "short hints", "use examples"
  emojiOk      Boolean @default(true)

  // learning state
  strengths  String[] @default([])
  weaknesses String[] @default([])
  goals      String[] @default([])

  // guardrail: avoid advanced topics
  maxDepth Int? // 1=very basic ... 5=advanced (we keep <=3 for bagrut by default)
}

model StudentBrainSnapshot {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId   String // student user id
  cohortId String?

  // compact analytics summary the tutor can read
  // (keep JSON flexible, schema later)
  metrics Json

  // example metrics you might store inside JSON:
  // { "math": {"avg": 78,"trend":"up","weak":["quadratic"],"strong":["trig"]}, ... }

  @@index([userId, createdAt])
  @@index([cohortId])
}

enum BrainEventType {
  CHAT_MESSAGE
  QUIZ_ATTEMPT
  QUIZ_RESULT
  MISTAKE
  HINT_USED
  CONCEPT_EXPLAINED
  CONFUSION
  PREFERENCE
}

enum BrainSkillStatus {
  UNKNOWN
  LEARNING
  OK
  STRONG
}

model StudentBrainProfile {
  id                String  @id @default(uuid())
  studentId         String  @unique
  // lightweight learning prefs (used in prompt injection)
  preferredLanguage String? // "en" | "ar" | "he"
  verbosity         String? // "concise" | "normal" | "detailed"
  quizFrequency     String? // "low" | "medium" | "high"
  tone              String? // "friendly" | "strict" | "coach"
  humor             String? // "none" | "light" | "more"
  addressName       String? // "first" | "full" | "none"

  // optional: stable baseline about the student (short)
  baselineSummary String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)

  @@index([studentId])
}

model StudentBrainSkill {
  id         String           @id @default(uuid())
  studentId  String
  subject    String
  topic      String
  status     BrainSkillStatus @default(UNKNOWN)
  strength   Int              @default(0) // 0..100 (simple scalar for now)
  lastSeenAt DateTime?

  evidenceCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)

  @@unique([studentId, subject, topic])
  @@index([studentId, subject])
}

model StudentBrainEvent {
  id             String         @id @default(uuid())
  studentId      String
  type           BrainEventType
  subject        String?
  topic          String?
  // short JSON-ish payload stored as string (keeps v1 simple, avoids jsonb migrations)
  payload        String?
  // optional linkage to tutor session/message
  tutorSessionId String?
  tutorMessageId String?

  createdAt DateTime @default(now())

  student StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  session TutorSession?  @relation(fields: [tutorSessionId], references: [id], onDelete: SetNull)
  message TutorMessage?  @relation(fields: [tutorMessageId], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
  @@index([tutorSessionId])
}

model StudentBrainSummary {
  id        String @id @default(uuid())
  studentId String @unique

  // rolling prompt context (short, cached)
  summary String

  // bookkeeping for refresh cadence
  lastEventAt DateTime?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  student StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)

  @@index([studentId])
}

model TutorSession {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  characterId String?
  character   TutorCharacter? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  updatedAt   DateTime        @updatedAt

  userId   String // student user id
  courseId String?
  cohortId String?

  // optional title/topic
  title String?
  topic String?

  messages    TutorMessage[]
  brainEvents StudentBrainEvent[]

  @@index([userId, updatedAt])
  @@index([cohortId])
  @@index([courseId])
}

model TutorMessage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  sessionId String
  role      TutorMessageRole
  content   String

  // what tutor used as sources (ids or short refs)
  sources String[] @default([])

  session     TutorSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  brainEvents StudentBrainEvent[]

  @@index([sessionId, createdAt])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  actorUserId String?
  actorRole   AnalyticsActorRole?

  // scope
  cohortId  String?
  courseId  String?
  studentId String?

  // event
  name    String
  payload Json?

  @@index([name, createdAt])
  @@index([cohortId])
  @@index([courseId])
  @@index([studentId])
}

enum TutorCharacterSubject {
  GENERAL
  MATH
  PHYSICS
  CS
  ENGLISH
  HEBREW
  ARABIC
}

model TutorCharacter {
  id          String   @id @default(cuid())
  createdById String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // scope (optional) – later we can make per cohort/school
  cohortId String?

  subject      TutorCharacterSubject @default(GENERAL)
  name         String // e.g. "Mr. Derivative", "Physics Coach"
  // how it speaks/behaves (high-level; real behavior comes later from AI brain + profile)
  tone         String? // friendly/strict/etc.
  verbosity    Int? // 1-10
  explainStyle String? // step-by-step / hints / examples

  // guardrails
  curriculum String? // e.g. "bagrut"
  maxGrade   Int? // 10/11/12
  language   String? // he/ar/en

  // later: prompt template / system rules
  systemNotes String? // short instruction block

  sessions TutorSession[]

  @@unique([cohortId, subject, name])
  @@index([cohortId])
  @@index([subject])
  @@index([cohortId, subject])
  @@index([isPublic, subject])
}

model TutorReplyCache {
  id                 String   @id @default(cuid())
  userId             String
  characterId        String?
  normalizedQuestion String
  topic              String?
  mode               String // "deterministic" | "llm"
  content            String
  refs               String?
  excerpt            String?
  createdAt          DateTime @default(now())
  expiresAt          DateTime

  @@unique([userId, characterId, normalizedQuestion, mode])
  @@index([userId, characterId])
}

// ### CLASSMATE:MODELS:BEGIN
model Solution {
  id             String   @id @default(uuid())
  authorId       String
  subject        String // "math" | "physics" | ...
  sourceType     String // "book" | "bagrut" | "other"
  sourceName     String? // book name OR bagrut year/season
  page           Int?
  questionNumber String? // "12" or "12a"
  title          String?
  notes          String?
  body           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  author User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  images SolutionImage[]

  likes    SolutionLike[]
  reposts  SolutionRepost[]
  comments SolutionComment[]

  @@unique([createdAt, id])
  @@index([createdAt])
  @@index([subject, sourceType])
  @@index([subject, sourceName, page])
  @@index([subject, sourceName, page, questionNumber])
  @@index([createdAt, id])
}

model SolutionImage {
  id         String @id @default(uuid())
  solutionId String

  // public URL (served from /uploads)
  url String

  // storage + metadata (for PDFs/scans/search)
  storagePath  String
  kind         String // "image" | "pdf" | "other"
  mime         String
  sizeBytes    Int
  originalName String?
  sha256       String?

  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  solution Solution @relation(fields: [solutionId], references: [id], onDelete: Cascade)

  @@index([solutionId])
  @@index([kind])
  @@index([mime])
  @@index([sha256])
}

model SolutionLike {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  solutionId String
  userId     String

  solution Solution @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([solutionId, userId])
  @@index([solutionId])
  @@index([userId])
}

model SolutionRepost {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  solutionId String
  userId     String

  solution Solution @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([solutionId, userId])
  @@index([solutionId])
  @@index([userId])
}

model SolutionComment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  body      String

  solutionId String
  authorId   String

  solution Solution @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([solutionId, createdAt])
  @@index([authorId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  data      Json?
  severity  String    @default("info") // info|success|warning|error
  seenAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, seenAt])
}

// ### CLASSMATE:MODELS:END

// ---- Session 10: School subject defaults + per-student overrides ----
model SchoolGradeSubjectDefault {
  id        String   @id @default(cuid())
  schoolId  String
  grade     Int
  subjects  String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, grade], name: "schoolId_grade_unique")
  @@index([schoolId])
}

model StudentSubjectOverride {
  id        String   @id @default(cuid())
  userId    String
  enabled   Boolean  @default(true)
  subjects  String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId])
  @@index([userId])
}

enum ScheduleTemplateKind {
  GRADE
  MAJOR
  COHORT
  STUDENT
}

model ScheduleTemplate {
  id       String               @id @default(uuid())
  schoolId String
  kind     ScheduleTemplateKind
  name     String

  // optional targeting keys (only used depending on kind)
  grade   Int?
  section Int?
  major   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slots        ScheduleTemplateSlot[]
  cohortBinds  CohortScheduleTemplate[]
  studentBinds StudentScheduleTemplate[]

  @@index([schoolId, kind])
  @@index([schoolId, grade, section])
  @@index([schoolId, major])
}

model ScheduleTemplateSlot {
  id         String  @id @default(uuid())
  templateId String
  dayOfWeek  Int // 0=Sun..6=Sat
  period     Int // 1..10
  courseId   String?
  teacherId  String?
  location   String?

  template ScheduleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  course   Course?          @relation(fields: [courseId], references: [id])
  teacher  User?            @relation("TeacherSlots", fields: [teacherId], references: [id])

  @@unique([templateId, dayOfWeek, period])
  @@index([templateId, dayOfWeek, period])
}

model CohortScheduleTemplate {
  id         String @id @default(uuid())
  cohortId   String
  templateId String
  priority   Int    @default(50) // lower = higher priority among same binding type

  cohort   Cohort           @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  template ScheduleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([cohortId, templateId])
  @@index([cohortId, priority])
  @@index([templateId])
}

model StudentScheduleTemplate {
  id         String @id @default(uuid())
  studentId  String
  templateId String
  priority   Int    @default(10) // student bindings should beat cohort by default

  student  User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  template ScheduleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([studentId, templateId])
  @@index([studentId, priority])
  @@index([templateId])
}

// --- Classroom tabs (Course == Classroom) ---
// Chat: WhatsApp-like messages (text + optional attachment URL metadata)
model ClassroomMessage {
  id           String               @id @default(cuid())
  courseId     String
  senderUserId String
  kind         ClassroomMessageKind @default(TEXT)
  text         String?
  mediaUrl     String?
  mediaMime    String?
  durationSec  Int?
  createdAt    DateTime             @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, createdAt])
  @@index([senderUserId, createdAt])
}

enum ClassroomMessageKind {
  TEXT
  VOICE
  IMAGE
  DOC
}

// Assignments: teacher posts assignments; students view
model ClassroomAssignment {
  id        String    @id @default(cuid())
  courseId  String
  title     String
  body      String?
  dueAt     DateTime?
  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, createdAt])
  @@index([courseId, dueAt])
}

// Materials: teacher posts materials (files/links)
model ClassroomMaterial {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  url         String
  mime        String?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, createdAt])
}

// Meetings: scheduled meetings (title + time + link)
model ClassroomMeeting {
  id        String    @id @default(cuid())
  courseId  String
  title     String
  startsAt  DateTime
  endsAt    DateTime?
  link      String
  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, startsAt])
  @@index([courseId, createdAt])
}

model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  type        String
  aggregateId String?   @map("aggregate_id") @db.Uuid
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at")
  availableAt DateTime  @default(now()) @map("available_at")
  processedAt DateTime? @map("processed_at")
  failedAt    DateTime? @map("failed_at")
  retryCount  Int       @default(0) @map("retry_count")
  error       String?

  @@index([processedAt, availableAt, createdAt], map: "idx_outbox_process_queue")
  @@index([type, createdAt], map: "idx_outbox_type_created_at")
  @@map("outbox_events")
}

model FeedSolutionCard {
  solutionId      String   @id @map("solution_id") @db.Uuid
  schoolId        String   @map("school_id") @db.Uuid
  classId         String?  @map("class_id") @db.Uuid
  authorId        String   @map("author_id") @db.Uuid
  authorName      String   @map("author_name")
  subject         String
  sourceType      String   @map("source_type")
  sourceName      String?  @map("source_name")
  page            Int?
  questionNumber  String?  @map("question_number")
  title           String?
  bodyPreview     String?  @map("body_preview")
  primaryImageUrl String?  @map("primary_image_url")
  imageCount      Int      @default(0) @map("image_count")
  likeCount       Int      @default(0) @map("like_count")
  commentCount    Int      @default(0) @map("comment_count")
  repostCount     Int      @default(0) @map("repost_count")
  rankingScore    Float    @default(0) @map("ranking_score")
  teacherPick     Boolean  @default(false) @map("teacher_pick")
  bestSolution    Boolean  @default(false) @map("best_solution")
  difficulty      String?
  createdAt       DateTime @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([schoolId, rankingScore(sort: Desc), createdAt(sort: Desc)], map: "idx_feed_solution_cards_school_rank_created")
  @@index([schoolId, subject, rankingScore(sort: Desc)], map: "idx_feed_solution_cards_school_subject_rank")
  @@index([schoolId, sourceName, page, questionNumber], map: "idx_feed_solution_cards_lookup")
  @@map("feed_solution_cards")
}

model ClassroomPreviewCard {
  classroomId       String    @id @map("classroom_id") @db.Uuid
  schoolId          String?   @map("school_id") @db.Uuid
  title             String
  subject           String?
  latestMessageText String?   @map("latest_message_text")
  latestMessageAt   DateTime? @map("latest_message_at")
  latestSenderName  String?   @map("latest_sender_name")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([schoolId, latestMessageAt(sort: Desc)], map: "idx_classroom_preview_cards_school_latest")
  @@map("classroom_preview_cards")
}

model ClassroomUserCounter {
  id                String    @id @default(uuid()) @db.Uuid
  classroomId       String    @map("classroom_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  unreadCount       Int       @default(0) @map("unread_count")
  lastSeenMessageId String?   @map("last_seen_message_id") @db.Uuid
  lastSeenAt        DateTime? @map("last_seen_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([classroomId, userId], map: "uq_classroom_user_counters_classroom_user")
  @@index([userId, unreadCount(sort: Desc)], map: "idx_classroom_user_counters_user_unread")
  @@map("classroom_user_counters")
}

model WeeklySolverLeaderboard {
  id                   String @id @default(uuid()) @db.Uuid
  schoolId             String @map("school_id") @db.Uuid
  weekKey              String @map("week_key")
  userId               String @map("user_id") @db.Uuid
  userName             String @map("user_name")
  solutionCount        Int    @default(0) @map("solution_count")
  likeCountReceived    Int    @default(0) @map("like_count_received")
  commentCountReceived Int    @default(0) @map("comment_count_received")
  repostCountReceived  Int    @default(0) @map("repost_count_received")
  score                Float  @default(0)

  @@unique([schoolId, weekKey, userId], map: "uq_weekly_solver_leaderboard_school_week_user")
  @@index([schoolId, weekKey, score(sort: Desc)], map: "idx_weekly_solver_leaderboard_rank")
  @@map("weekly_solver_leaderboard")
}

model BagrutQuestion {
  id            String @id @default(cuid())
  subject       String
  topicLabel    String
  year          Int
  season        String
  examCode      String
  questionIndex Int

  promptLatex   String
  solutionLatex String

  difficulty String
  points     Int

  createdAt DateTime @default(now())
}

enum SolutionModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SolutionVerificationStatus {
  UNCHECKED
  VERIFIED
  REJECTED
}

model SolutionBook {
  id        String   @id @default(cuid())
  subject   String
  title     String
  slug      String?
  createdAt DateTime @default(now())

  solutions SolutionUpload[]

  @@unique([subject, title])
  @@index([subject])
}

model SolutionUpload {
  id                 String                     @id @default(cuid())
  userId             String
  subject            String
  bookId             String
  caption            String?
  pageNumber         Int
  questionNumber     String
  uploaderName       String?
  uploaderInitials   String?
  moderationStatus   SolutionModerationStatus   @default(PENDING)
  verificationStatus SolutionVerificationStatus @default(UNCHECKED)
  moderationReason   String?
  verificationNote   String?
  isDeleted          Boolean                    @default(false)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  book  SolutionBook         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  files SolutionUploadFile[]

  @@index([userId, createdAt])
  @@index([subject, pageNumber, createdAt])
  @@index([subject, bookId, pageNumber, questionNumber])
  @@index([bookId])
}

model SolutionUploadFile {
  id        String   @id @default(cuid())
  uploadId  String
  kind      String
  url       String
  mimeType  String?
  fileName  String?
  fileSize  Int?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  upload SolutionUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([uploadId, sortOrder])
}

model PracticeAttempt {
  id            String   @id @default(cuid())
  userId        String
  sessionId     String?
  subject       String
  topicLabel    String
  mode          String
  difficulty    String
  questionId    String
  prompt        String
  selectedIndex Int?
  correctIndex  Int
  isCorrect     Boolean
  timeTakenMs   Int?
  awardedScore  Int      @default(0)
  usedNova      Boolean  @default(false)
  source        String   @default("ai")
  createdAt     DateTime @default(now())

  @@index([userId, sessionId, createdAt])
  @@index([userId, subject, topicLabel, createdAt])
  @@index([userId, createdAt])
}

model PracticeSkillProfile {
  id           String   @id @default(cuid())
  userId       String
  subject      String
  topicLabel   String
  theta        Float    @default(0)
  uncertainty  Float    @default(1)
  streak       Int      @default(0)
  totalSeen    Int      @default(0)
  totalCorrect Int      @default(0)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@unique([userId, subject, topicLabel])
  @@index([userId, subject, updatedAt])
}

enum DmThreadType {
  DIRECT
  GROUP
}

enum DmParticipantRole {
  MEMBER
  ADMIN
}

enum DmParticipantState {
  PENDING_INCOMING
  PENDING_OUTGOING
  ACCEPTED
  BLOCKED
}

enum DmMessageKind {
  TEXT
  IMAGE
  VOICE
  SYSTEM
}

enum DmMediaMode {
  ONCE
  REPLAY
  KEEP
}

model DmThread {
  id           String          @id @default(cuid())
  type         DmThreadType    @default(DIRECT)
  title        String?
  createdById  String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  participants DmParticipant[]
  messages     DmMessage[]
}

model DmParticipant {
  id         String             @id @default(cuid())
  threadId   String
  userId     String
  role       DmParticipantRole  @default(MEMBER)
  state      DmParticipantState @default(ACCEPTED)
  lastSeenAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  thread     DmThread           @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([userId, state])
}

model DmMessage {
  id            String          @id @default(cuid())
  threadId      String
  senderId      String
  kind          DmMessageKind   @default(TEXT)
  text          String?
  mediaUrl      String?
  mediaMimeType String?
  mediaMode     DmMediaMode?
  viewLimit     Int?
  replayLimit   Int?
  expiresAt     DateTime?
  createdAt     DateTime        @default(now())
  thread        DmThread        @relation(fields: [threadId], references: [id], onDelete: Cascade)
  views         DmMessageView[]
  reactions     DmReaction[]

  @@index([threadId, createdAt])
}

model DmMessageView {
  id          String    @id @default(cuid())
  messageId   String
  viewerId    String
  viewedAt    DateTime  @default(now())
  replayCount Int       @default(0)
  message     DmMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, viewerId])
}

model DmReaction {
  id        String    @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime  @default(now())
  message   DmMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}
