  subject          String?
  dueAt            DateTime?
  maxGrade         Int?
  targetType       AssignmentTargetType @default(EVERYONE)
  targetCohortIds  String[]             @default([])
  targetStudentIds String[]             @default([])
  targetGrades     Int[]                @default([])
  attachments      Json                 @default("[]")
