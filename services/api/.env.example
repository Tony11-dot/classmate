# ClassMate API — environment template.
# Copy to `.env` (local) and set real values. NEVER commit a filled-in .env.
# Production values live in Railway env vars, not in any file.
# Only DATABASE_URL + JWT_SECRET are strictly required to boot; the rest enable
# individual integrations (AI, email, SMS, push, billing, error reporting).

# ── Core / HTTP ───────────────────────────────────────────────────────────
PORT=3001
HOST=127.0.0.1
# NOTE: the app does NOT call setGlobalPrefix — routes are served at the root,
# so API_PREFIX is currently inert (kept only for the e2e harness). Don't rely
# on a /api prefix in clients.
APP_ENV=development                 # production | development | test
DATABASE_URL="postgresql://classmate:classmate@127.0.0.1:5433/classmate?schema=public"

# ── Auth ──────────────────────────────────────────────────────────────────
# REQUIRED in prod. Use a long random string (>=32 chars). No fallback in prod.
JWT_SECRET=dev-secret-change-me
# Comma-separated allowlist of browser origins for the Flutter web build.
# NOTE the plural — main.ts reads CORS_ORIGINS (CORS_ORIGIN is ignored).
# Leave unset only in non-public dev; set it in production to lock CORS down.
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Dev auth bypass — local ONLY. Relaxes role checks; requires BOTH this flag
# AND APP_ENV in {development,dev,test} (see src/auth/dev-bypass.ts).
# Headers: X-Dev-User: <uuid> , X-Dev-Roles: STUDENT,PARENT,ADMIN
DEV_AUTH_BYPASS=0

# ── AI providers (NOVA tutor, practice, grading) ──────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8     # optional override
OPENAI_API_KEY=                     # transcription / fallback only
OPENAI_TRANSCRIBE_MODEL=

# ── Email (Resend) ────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=

# ── SMS / phone verify (Twilio) ───────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── Push notifications (Firebase Admin) ───────────────────────────────────
# Inline JSON of the service account, OR a path via GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# ── Billing (RevenueCat) ──────────────────────────────────────────────────
REVENUECAT_WEBHOOK_SECRET=

# ── Error reporting (Sentry) ──────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENV=

# ── Cache / queue (Redis) ─────────────────────────────────────────────────
REDIS_HOST=
REDIS_PORT=

# ── Ops / misc ────────────────────────────────────────────────────────────
PUBLIC_APP_URL=https://classmate-f17d6.web.app   # used in emailed links
SETUP_SECRET=                       # gates the one-time /setup + DB-wipe route
PLATFORM_OWNER_EMAIL=
PLATFORM_OWNER_PHONE=
