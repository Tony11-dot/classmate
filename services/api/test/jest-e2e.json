{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "globalSetup": "<rootDir>/jest-e2e.global-setup.cjs",
  "setupFilesAfterEnv": [
    "<rootDir>/jest-e2e.setup.cjs",
    "<rootDir>/test/jest-e2e.setup.cjs"
  ]
}
