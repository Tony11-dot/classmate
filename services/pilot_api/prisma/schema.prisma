generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Assignment {
  id          String @id @default(cuid())
  schoolId    String
  classroomId String
  subjectId   String
  createdById String

  title     String
  details   String?
  dueAt     DateTime?
  createdAt DateTime  @default(now())

  Classroom Classroom @relation(fields: [classroomId], references: [id])
  Subject   Subject   @relation(fields: [subjectId], references: [id])
  User      User      @relation("UserAssignments", fields: [createdById], references: [id])

  submissions AssignmentSubmission[]

  @@index([schoolId, classroomId])
  @@index([subjectId])
}

model AttendanceRecord {
  id        String   @id @default(cuid())
  userId    String
  subjectId String
  date      DateTime
  status    String
  teacher   String?
  createdAt DateTime @default(now())

  Subject Subject @relation(fields: [subjectId], references: [id])
  User    User    @relation(fields: [userId], references: [id])

  @@index([userId, date])
}

model Classroom {
  id        String   @id @default(cuid())
  schoolId  String
  grade     Int
  subjectId String
  title     String
  createdAt DateTime @default(now())

  Subject         Subject           @relation(fields: [subjectId], references: [id])
  ClassroomMember ClassroomMember[]
  Message         Message[]
  Assignment      Assignment[]
  Solution        Solution[]
  ScheduleEntries ScheduleEntry[]

  @@unique([schoolId, grade, subjectId])
  @@index([schoolId, grade])
}

model ClassroomMember {
  id          String   @id @default(cuid())
  classroomId String
  userId      String
  role        String   @default("student")
  createdAt   DateTime @default(now())

  Classroom Classroom @relation(fields: [classroomId], references: [id])
  User      User      @relation(fields: [userId], references: [id])

  @@unique([classroomId, userId])
  @@index([userId])
}

model Grade {
  id        String   @id @default(cuid())
  userId    String
  subjectId String
  title     String
  score     Float
  maxScore  Float    @default(100)
  date      DateTime
  createdAt DateTime @default(now())

  Subject Subject @relation(fields: [subjectId], references: [id])
  User    User    @relation(fields: [userId], references: [id])
}

model GradeSubjectPack {
  id String @id @default(cuid())

  schoolId  String   @default("demo-school")
  grade     Int
  kind      String
  subjectId String
  createdAt DateTime @default(now())

  Subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([schoolId, grade, kind, subjectId])
  @@index([schoolId, grade])
  @@index([grade, kind])
}

model Message {
  id          String   @id @default(cuid())
  classroomId String
  userId      String
  kind        String   @default("text")
  text        String?
  mediaUrl    String?
  createdAt   DateTime @default(now())

  Classroom Classroom @relation(fields: [classroomId], references: [id])
  User      User      @relation(fields: [userId], references: [id])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String
  title     String
  body      String?
  seenAt    DateTime?
  createdAt DateTime  @default(now())

  User User @relation(fields: [userId], references: [id])
}

model ScheduleEntry {
  id          String   @id @default(cuid())
  schoolId    String
  classroomId String
  userId      String? // optional personal events later
  subjectId   String
  startAt     DateTime
  endAt       DateTime
  room        String?
  teacher     String?
  createdAt   DateTime @default(now())

  Classroom Classroom @relation(fields: [classroomId], references: [id])
  Subject   Subject   @relation(fields: [subjectId], references: [id])
  User      User?     @relation(fields: [userId], references: [id])

  @@index([schoolId, startAt])
  @@index([classroomId, startAt])
  @@index([userId, startAt])
}

model School {
  id   String @id
  name String @unique

  User        User[]
  adminScopes AdminScope[]
}

model Solution {
  id          String @id @default(cuid())
  schoolId    String
  classroomId String
  userId      String
  subjectId   String

  grade     Int
  book      String
  page      Int
  question  String
  caption   String?
  mediaUrl  String
  createdAt DateTime @default(now())

  Classroom Classroom @relation(fields: [classroomId], references: [id])
  Subject   Subject   @relation(fields: [subjectId], references: [id])
  User      User      @relation(fields: [userId], references: [id])

  SolutionComment SolutionComment[]
  SolutionLike    SolutionLike[]

  @@index([schoolId, classroomId])
  @@index([subjectId, grade, book, page])
}

model SolutionComment {
  id         String   @id @default(cuid())
  solutionId String
  userId     String
  text       String
  createdAt  DateTime @default(now())

  Solution Solution @relation(fields: [solutionId], references: [id])
  User     User     @relation(fields: [userId], references: [id])
}

model SolutionLike {
  id         String   @id @default(cuid())
  solutionId String
  userId     String
  createdAt  DateTime @default(now())

  Solution Solution @relation(fields: [solutionId], references: [id])
  User     User     @relation(fields: [userId], references: [id])

  @@unique([solutionId, userId])
}

model StudentSubject {
  id        String   @id @default(cuid())
  schoolId  String   @default("demo-school")
  userId    String
  subjectId String
  source    String
  createdAt DateTime @default(now())

  Subject Subject @relation(fields: [subjectId], references: [id])
  User    User    @relation(fields: [userId], references: [id])

  @@unique([schoolId, userId, subjectId])
  @@index([schoolId, userId])
}

model Subject {
  id       String @id @default(cuid())
  schoolId String @default("demo-school")
  name     String

  Assignment       Assignment[]
  AttendanceRecord AttendanceRecord[]
  Classroom        Classroom[]
  Grade            Grade[]
  GradeSubjectPack GradeSubjectPack[]
  ScheduleEntry    ScheduleEntry[]
  Solution         Solution[]
  StudentSubject   StudentSubject[]
  majorSubjects    MajorSubject[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  username     String   @unique
  nationalId   String?  @unique
  grade        Int
  schoolId     String
  createdAt    DateTime @default(now())

  scientificMajor    String?
  technologicalMajor String?
  mathUnits          String?
  englishUnits       String?

  AttendanceRecord AttendanceRecord[]
  ClassroomMember  ClassroomMember[]
  Grade            Grade[]
  Message          Message[]
  Notification     Notification[]
  ScheduleEntry    ScheduleEntry[]
  Solution         Solution[]
  SolutionComment  SolutionComment[]
  SolutionLike     SolutionLike[]
  StudentSubject   StudentSubject[]

  School School @relation(fields: [schoolId], references: [id])

  assignmentSubmissions AssignmentSubmission[]
  roles                 UserRole[]

  Assignment  Assignment[] @relation("UserAssignments")
  adminScopes AdminScope[]
}

model AssignmentSubmission {
  id           String   @id @default(cuid())
  assignmentId String
  userId       String
  text         String?
  mediaUrl     String?
  createdAt    DateTime @default(now())

  Assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  User       User       @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([assignmentId, userId])
  @@index([assignmentId])
  @@index([userId])
}

model Role {
  id   String @id
  name String @unique

  users UserRole[]
}

model UserRole {
  userId String
  roleId String

  User User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  Role Role @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model Major {
  id       String @id @default(cuid())
  schoolId String @default("demo-school")
  name     String
  type     String // scientific | technological

  MajorSubject MajorSubject[]

  @@unique([schoolId, type, name])
  @@index([schoolId, type])
}

model MajorSubject {
  id        String @id @default(cuid())
  schoolId  String @default("demo-school")
  majorId   String
  subjectId String

  Major   Major   @relation(fields: [majorId], references: [id], onDelete: Cascade)
  Subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([schoolId, majorId, subjectId])
  @@index([schoolId, majorId])
}

model AdminScope {
  id        String   @id @default(cuid())
  userId    String
  schoolId  String
  gradeMin  Int?
  gradeMax  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  School School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@unique([userId, schoolId, gradeMin, gradeMax])
  @@index([schoolId])
  @@index([userId])
}
