services:
  db:
    image: postgres:16
    restart: unless-stopped
    environment:
      POSTGRES_DB: classmate
      POSTGRES_USER: classmate
      POSTGRES_PASSWORD: classmate
    ports:
      - "5432:5432"
    volumes:
      - classmate_db:/var/lib/postgresql/data

  pilot_api:
    build:
      context: ./services/pilot_api
    restart: unless-stopped
    depends_on:
      - db
    env_file:
      - ./services/pilot_api/.env
    environment:
      # LLM
      LLM_PROVIDER: ${LLM_PROVIDER:-openai}
      OPENAI_API_KEY: ${OPENAI_API_KEY}
      OPENAI_MODEL: ${OPENAI_MODEL:-gpt-4o-mini}

      # DB / app (keep your existing app reading these if needed)
      DATABASE_URL: ${DATABASE_URL:-postgresql://classmate:classmate@db:5432/classmate?schema=public}
      NODE_ENV: ${NODE_ENV:-production}
    ports:
      - "3000:3000"

volumes:
  classmate_db:
