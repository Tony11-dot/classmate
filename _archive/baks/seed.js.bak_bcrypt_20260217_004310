const { PrismaClient } = require("@prisma/client");
const prisma = new PrismaClient();

async function upsertSubject(schoolId, name) {
  const sid =
    "sub_" +
    String(name)
      .trim()
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, "_")
      .replace(/^_+|_+$/g, "");

  return prisma.subject.upsert({
    where: { schoolId_name: { schoolId, name } },
    update: {},
    create: { id: sid, schoolId, name },
  });
}

async function main() {
  // 1) Demo school
    const school = await prisma.school.upsert({
    where: { id: "demo-school" },
    update: { name: "demo-school" },
    create: {
      id: "demo-school",
      name: "demo-school",
    },
  });

  // Clean old packs (seed should be idempotent + not keep leftovers)
  await prisma.gradeSubjectPack.deleteMany({});

// 2) Subject name map (you can expand later)
  const core = ["Arabic", "Hebrew", "PE", "Religion", "Chapel"];
  const g78 = ["Math", "Chemistry", "Biology", "Electronics"];
  const g9 = ["Math", "Chemistry", "Biology", "Electronics", "Physics", "Computer Science"];
  const g10p = ["English", "Math", "Physics", "Computer Science"];

  // Ensure subjects exist
  const all = [...new Set([...core, ...g78, ...g9, ...g10p])];
  const byName = new Map();
  for (const name of all) {
    const s = await upsertSubject(school.id, name);
    byName.set(name, s);
  }

  // 3) GradeSubjectPack seed
  const packRows = [];
  // kind: "core" => always, "grade" => grade-based
    async function pack(grade, kind, subjectName) {
    const subject = byName.get(subjectName);
    if (!subject) throw new Error("Missing subject: " + subjectName);
    packRows.push({
      id: `gsp_${school.id}_${grade}_${kind}_${subject.id}`,
      schoolId: school.id,
      grade,
      kind,
      subjectId: subject.id,
    });
  }

  for (const g of [7, 8, 9, 10, 11, 12]) {
    for (const name of core) await pack(g, "core", name);
  }
  for (const g of [7, 8]) {
    for (const name of g78) await pack(g, "grade", name);
  }
  for (const name of g9) await pack(9, "grade", name);
  for (const g of [10, 11, 12]) {
    for (const name of g10p) await pack(g, "grade", name);
  }

  // Replace packs for this school
  await prisma.gradeSubjectPack.deleteMany({ where: { schoolId: school.id } });
  if (packRows.length) await prisma.gradeSubjectPack.createMany({ data: packRows, skipDuplicates: true });


  // 4) Roles (idempotent)
  async function upsertRole(id, name) {
    return prisma.role.upsert({
      where: { id },
      update: { name },
      create: { id, name },
    });
  }

  const rStudent = await upsertRole("student", "student");
  const rTeacher = await upsertRole("teacher", "teacher");
  const rAdmin   = await upsertRole("admin", "admin");

  // 5) Demo Admin user (scoped 4–12), also teacher
  // login: admin@demo.com / Password123!
  const bcrypt = require("bcryptjs");

  const adminEmail = "admin@demo.com";
  const adminUsername = "admin";
  const adminPasswordHash = await bcrypt.hash("Password123!", 10);

  const adminUser = await prisma.user.upsert({
    where: { email: adminEmail },
    update: {
      fullName: "Demo Admin",
      username: adminUsername,
      grade: 12,
      schoolId: school.id,
      passwordHash: adminPasswordHash,
    },
    create: {
      email: adminEmail,
      passwordHash: adminPasswordHash,
      fullName: "Demo Admin",
      username: adminUsername,
      grade: 12,
      schoolId: school.id,
    },
  });

  // attach roles
  await prisma.userRole.createMany({
    data: [
      { userId: adminUser.id, roleId: rAdmin.id },
      { userId: adminUser.id, roleId: rTeacher.id },
    ],
    skipDuplicates: true,
  });

  // admin scope: grades 4–12 for demo-school
  await prisma.adminScope.upsert({
    where: { userId_schoolId_gradeMin_gradeMax: { userId: adminUser.id, schoolId: school.id, gradeMin: 4, gradeMax: 12 } },
    update: {},
    create: { userId: adminUser.id, schoolId: school.id, gradeMin: 4, gradeMax: 12 },
  });

  console.log("✅ Seed complete:", {
    school: school.name,
    subjects: all.length,
  });
}

main()
  .catch((e) => {
    console.error(e);
    process.exit(1);
  })
  .finally(async () => {
    // IMPORTANT: keep as string access so shells never eat $disconnect
    await prisma["$disconnect"]();
  });
