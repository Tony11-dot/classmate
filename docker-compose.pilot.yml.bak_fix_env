services:
  db:
    image: postgres:16
    environment:
      - OLLAMA_MODEL=phi3:latest
      POSTGRES_USER: classmate
      POSTGRES_PASSWORD: classmate_pw
      POSTGRES_DB: classmate
    ports:
      - "5432:5432"
    volumes:
      - dbdata:/var/lib/postgresql/data
    restart: unless-stopped

  pilot_api:
    env_file:
      - ./services/pilot_api/.env
    build:
      context: ./services/pilot_api
    environment:
      TZ: UTC
      DATABASE_URL: postgresql://classmate:classmate_pw@db:5432/classmate?schema=public
      PORT: 3000
      CORS_ORIGIN: "*"
    depends_on:
      - db
    ports:
      - "3010:3000"
    restart: unless-stopped

volumes:
  dbdata:
