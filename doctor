#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

die() { echo "❌ $*" >&2; exit 1; }
ok()  { echo "✅ $*"; }
info(){ echo "ℹ️  $*"; }

require_cmd() { command -v "$1" >/dev/null 2>&1 || die "Missing command: $1"; }

require_cmd docker
require_cmd curl
require_cmd awk
require_cmd grep
require_cmd sed

info "Docker daemon..."
docker info >/dev/null 2>&1 || die "Docker daemon not running. Start Docker Desktop and retry."
ok "Docker daemon is running"

info "Compose bring-up (idempotent)..."
docker compose up -d >/dev/null
ok "docker compose up -d ok"

info "Compose status..."
docker compose ps

API_PORT="${API_PORT:-3000}"
ADMIN_PORT="${ADMIN_PORT:-3001}"
PARENT_PORT="${PARENT_PORT:-3002}"

check_listen() {
  local port="$1" name="$2"
  if ! (lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1); then
    die "$name not listening on :$port"
  fi
  ok "$name is listening on :$port"
}

info "Ports..."
# lsof exists on mac; if not, skip hard-fail
if command -v lsof >/dev/null 2>&1; then
  check_listen "$API_PORT"   "API"
  check_listen "$ADMIN_PORT" "Admin Web"
  check_listen "$PARENT_PORT" "Parent Web"
else
  info "lsof not found; skipping port listen checks"
fi

wait_http_ok() {
  local url="$1" name="$2" attempts="${3:-80}" delay="${4:-0.25}"
  for _ in $(seq 1 "$attempts"); do
    if curl -fsS "$url" >/dev/null 2>&1; then
      ok "$name OK: $url"
      return 0
    fi
    sleep "$delay"
  done
  die "$name failed: $url"
}

info "API health/ready..."
wait_http_ok "http://localhost:${API_PORT}/api/health" "API health"
wait_http_ok "http://localhost:${API_PORT}/api/ready"  "API ready"

info "DB connectivity (inside db container)..."
DB_CID="$(docker compose ps -q db || true)"
[ -n "${DB_CID:-}" ] || die "db container not found"
docker exec "$DB_CID" sh -lc 'psql -U "${POSTGRES_USER:-classmate}" -d "${POSTGRES_DB:-classmate}" -c "select 1;"' >/dev/null 2>&1 \
  || die "db psql check failed inside container"
ok "DB psql check ok"

info "API container health status..."
API_CID="$(docker compose ps -q api || true)"
[ -n "${API_CID:-}" ] || die "api container not found"
HEALTH="$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}<none>{{end}}' "$API_CID" 2>/dev/null || echo unknown)"
[ "$HEALTH" = "healthy" ] || die "api health is not healthy: $HEALTH"
ok "API container is healthy"

ok "ALL GREEN ✅"
