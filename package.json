{
  "name": "classmate",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "approve-builds": "pnpm approve-builds",
    "seed:test": "node scripts/seed-test.mjs",
    "dev": "pnpm -r --parallel --filter api run dev",
    "dev:api": "pnpm --dir services/api dev",
    "install:all": "pnpm install && pnpm -r install",
    "build": "pnpm -r -w --workspace-concurrency=1 --filter ./services/api run build",
    "typecheck": "pnpm -r -w --filter ./services/api run typecheck",
    "lint:all": "pnpm -r -w --filter ./services/api run lint",
    "test:all": "pnpm -r -w --filter ./services/api run test",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down -v",
    "docker:logs": "docker compose logs -f --tail=120",
    "docker:ps": "docker compose ps"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-module-utils": "^2.12.1",
    "eslint-plugin-import": "^2.32.0"
  },
  "pnpm": {
    "overrides": {
      "eslint": "^8.57.0"
    }
  }
}
