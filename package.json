{
  "name": "classmate",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "install:all": "pnpm install && pnpm -r install",
    "approve-builds": "pnpm approve-builds",
    "dev:api": "pnpm --dir services/api dev",
    "dev:admin": "pnpm --dir apps/admin-web dev",
    "test:e2e:attendance": "WEB_BASE=http://localhost:3001 pnpm --dir apps/admin-web exec playwright test e2e/attendance.spec.ts --reporter=list",
    "test:e2e:grades": "pnpm --dir apps/admin-web exec playwright test e2e/grades.spec.ts --reporter=list",
    "test:e2e": "pnpm run test:e2e:attendance && pnpm run test:e2e:grades && pnpm run test:e2e:parent",
    "smoke:api": "node scripts/smoke-api.mjs",
    "dev": "pnpm -r --parallel --filter api --filter admin-web run dev",
    "test:e2e:parent": "pnpm --dir apps/parent-web exec playwright test --reporter=list",
    "dev:parent": "pnpm --dir apps/parent-web dev",
    "test:e2e:all": "pnpm -s test:e2e",
    "devx:start": "bash scripts/devx.sh start",
    "devx:stop": "bash scripts/devx.sh stop",
    "devx:logs": "bash scripts/devx.sh logs",
    "devx:test": "bash scripts/devx.sh test",
    "devx:ps": "bash scripts/devx.sh ps",
    "devx:clean": "bash scripts/devx.sh clean"
  }
}
