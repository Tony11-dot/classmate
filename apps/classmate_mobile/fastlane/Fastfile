PROD_API = "https://pacific-enchantment-production-7a80.up.railway.app"
IOS_IPA  = "build/ios/ipa/ClassMate.ipa"
APK_PATH = "build/app/outputs/flutter-apk/app-release.apk"

# ── Helpers ──────────────────────────────────────────────────────────────────

def flutter_build_ios
  # Clear fastlane's Ruby/Bundler env vars before invoking flutter — otherwise
  # Flutter's subprocess inherits GEM_HOME/BUNDLE_GEMFILE from fastlane and
  # CocoaPods fails with "installed but broken".
  sh "cd .. && env -u GEM_HOME -u GEM_PATH -u BUNDLE_GEMFILE -u BUNDLE_BIN_PATH -u RUBYOPT -u RUBYLIB \
    flutter build ipa --release \
    --dart-define=CM_API_BASE_URL=#{PROD_API} \
    --export-options-plist=ios/ExportOptions.plist"
end

def flutter_build_android
  sh "cd .. && flutter build apk --release \
    --dart-define=CM_API_BASE_URL=#{PROD_API}"
end

def flutter_build_aab
  sh "cd .. && flutter build appbundle --release \
    --dart-define=CM_API_BASE_URL=#{PROD_API}"
end

# Path (relative to the project root that fastlane runs from) to the Google
# Play service-account JSON. Download it from Play Console → Setup → API access
# → Service accounts, grant it "Release apps to testing tracks" + "Release to
# production", and drop the file here. It is gitignored — never commit it.
PLAY_JSON = "fastlane/play-service-account.json"
AAB_PATH  = "build/app/outputs/bundle/release/app-release.aab"

# ── iOS lanes ─────────────────────────────────────────────────────────────────

platform :ios do

  desc "Upload to TestFlight (beta)"
  lane :beta do
    flutter_build_ios
    upload_to_testflight(
      ipa:                        IOS_IPA,
      # Reliable: upload + set changelog, don't block on processing. The
      # group-distribution path (groups: + waiting) uploaded fine but then
      # errored, so we let App Store Connect handle internal-group
      # distribution (enable "auto-distribute" on the Devs group once).
      skip_waiting_for_build_processing: true,
      changelog:                  "ClassMate beta build — #{Time.now.strftime('%Y-%m-%d')}",
    )
    UI.success "✅ Uploaded to TestFlight!"
  end

  desc "Upload existing IPA to TestFlight (skip build)"
  lane :upload do
    upload_to_testflight(
      ipa:                        IOS_IPA,
      skip_waiting_for_build_processing: true,
      changelog:                  "ClassMate beta build — #{Time.now.strftime('%Y-%m-%d')}",
    )
    UI.success "✅ Uploaded to TestFlight!"
  end

  desc "Build, upload, and submit to App Store review (1-command public release)"
  lane :release do
    flutter_build_ios
    deliver(
      ipa:                 IOS_IPA,
      submit_for_review:   true,    # actually submits for Apple review
      automatic_release:   false,   # you press "Release" after approval
      force:               true,    # skip the HTML preview/confirm prompt
      skip_metadata:       true,    # use the listing already in App Store Connect
      skip_screenshots:    true,
      precheck_include_in_app_purchases: false,
      submission_information: { export_compliance_uses_encryption: false },
    )
    UI.success "✅ Submitted to App Store review!"
  end

end

# ── Android lanes ─────────────────────────────────────────────────────────────

platform :android do

  desc "Distribute via Firebase App Distribution (beta)"
  lane :beta do
    flutter_build_android
    firebase_app_distribution(
      app:            "1:682658545733:android:2ce716747ff621c41aa32c",
      groups:         "beta-testers",
      release_notes:  "ClassMate beta — #{Time.now.strftime('%Y-%m-%d')}",
      apk_path:       "../#{APK_PATH}",
    )
    UI.success "✅ Distributed via Firebase!"
  end

  desc "Build AAB and upload to Play Console INTERNAL testing track"
  lane :internal do
    flutter_build_aab
    upload_to_play_store(
      track:                   "internal",
      aab:                     AAB_PATH,
      json_key:                PLAY_JSON,
      skip_upload_apk:         true,
      skip_upload_metadata:    true,
      skip_upload_images:      true,
      skip_upload_screenshots: true,
      release_status:          "completed",
    )
    UI.success "✅ Uploaded to Play internal testing!"
  end

  desc "Build AAB and roll out to Play Console PRODUCTION"
  lane :production do
    flutter_build_aab
    upload_to_play_store(
      track:                   "production",
      aab:                     AAB_PATH,
      json_key:                PLAY_JSON,
      skip_upload_apk:         true,
      skip_upload_metadata:    true,
      skip_upload_images:      true,
      skip_upload_screenshots: true,
      # Staged rollout — bump toward 1.0 as you gain confidence, or remove
      # this line to release to 100% immediately.
      rollout:                 "0.2",
    )
    UI.success "✅ Rolled out to Play production (20%)!"
  end

end
