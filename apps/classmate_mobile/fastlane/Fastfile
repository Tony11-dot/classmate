PROD_API = "https://pacific-enchantment-production-7a80.up.railway.app"
IOS_IPA  = "build/ios/ipa/ClassMate.ipa"
APK_PATH = "build/app/outputs/flutter-apk/app-release.apk"

# ── Helpers ──────────────────────────────────────────────────────────────────

def flutter_build_ios
  # Clear fastlane's Ruby/Bundler env vars before invoking flutter — otherwise
  # Flutter's subprocess inherits GEM_HOME/BUNDLE_GEMFILE from fastlane and
  # CocoaPods fails with "installed but broken".
  sh "cd .. && env -u GEM_HOME -u GEM_PATH -u BUNDLE_GEMFILE -u BUNDLE_BIN_PATH -u RUBYOPT -u RUBYLIB \
    flutter build ipa --release \
    --obfuscate --split-debug-info=build/symbols \
    --dart-define=CM_API_BASE_URL=#{PROD_API} \
    --export-options-plist=ios/ExportOptions.plist"
end

def flutter_build_android
  sh "cd .. && flutter build apk --release \
    --obfuscate --split-debug-info=build/symbols \
    --dart-define=CM_API_BASE_URL=#{PROD_API}"
end

def flutter_build_aab
  sh "cd .. && flutter build appbundle --release \
    --obfuscate --split-debug-info=build/symbols \
    --dart-define=CM_API_BASE_URL=#{PROD_API}"
end

# Path (relative to the project root that fastlane runs from) to the Google
# Play service-account JSON. Download it from Play Console → Setup → API access
# → Service accounts, grant it "Release apps to testing tracks" + "Release to
# production", and drop the file here. It is gitignored — never commit it.
PLAY_JSON = "fastlane/play-service-account.json"
AAB_PATH  = "build/app/outputs/bundle/release/app-release.aab"

# ── Auth: App Store Connect API key ────────────────────────────────────────────
# When ASC_ISSUER_ID is exported in your shell, authenticate the WHOLE App Store
# Connect API non-interactively — no 2FA, no app-specific password, works for
# TestFlight uploads, changelogs, and App Store submission alike.
#
# Set these once in ~/.zshrc (only ASC_ISSUER_ID is mandatory; the other two
# default to the key already on disk):
#   export ASC_ISSUER_ID="<uuid from App Store Connect → Users and Access →
#                          Integrations → App Store Connect API → Issuer ID>"
#   export ASC_KEY_ID="28AUQ58BDS"                       # optional override
#   export ASC_KEY_PATH="~/Documents/AuthKey_28AUQ58BDS.p8"  # optional override
#
# Returns the key hash (to pass as api_key:) or nil to fall back to the
# Apple-ID + app-specific-password path.
def asc_api_key
  issuer = (ENV["ASC_ISSUER_ID"] || "").strip
  if issuer.empty?
    UI.important "ASC_ISSUER_ID not set — using Apple-ID + app-specific password."
    return nil
  end
  key_path = File.expand_path(ENV["ASC_KEY_PATH"] || "~/Documents/AuthKey_28AUQ58BDS.p8")
  unless File.exist?(key_path)
    UI.important "ASC key not found at #{key_path} — falling back to Apple-ID auth."
    return nil
  end
  app_store_connect_api_key(
    key_id:       ENV["ASC_KEY_ID"] || "28AUQ58BDS",
    issuer_id:    issuer,
    key_filepath: key_path,
    in_house:     false,
  )
end

# ── Sentry: upload debug symbols (dSYMs / split-debug) ─────────────────────────
# Runs the sentry_dart_plugin (config lives in pubspec.yaml: org classmate-02,
# project flutter). No-op unless SENTRY_AUTH_TOKEN is exported in your shell.
# Set once in ~/.zshrc:  export SENTRY_AUTH_TOKEN="sntrys_…"
def upload_sentry_symbols
  token = (ENV["SENTRY_AUTH_TOKEN"] || "").strip
  if token.empty?
    tf = File.expand_path("~/.classmate_sentry_token")
    token = File.read(tf).strip if File.exist?(tf)
  end
  if token.empty?
    UI.important "No Sentry token (env SENTRY_AUTH_TOKEN or ~/.classmate_sentry_token) — skipping symbol upload."
    return
  end
  ENV["SENTRY_AUTH_TOKEN"] = token   # inherited by the dart subprocess below
  ENV["SENTRY_HTTP_MAX_RETRIES"] = "10"
  UI.message "Uploading debug symbols to Sentry…"
  # Non-fatal + retried: the chunked upload is resumable, but the network can
  # still reset mid-stream. Symbol upload must NEVER abort a release — call this
  # AFTER the store upload, and swallow failures (resume later with
  # scripts/upload-sentry-symbols.sh).
  3.times do |i|
    begin
      sh "cd .. && env -u GEM_HOME -u GEM_PATH -u BUNDLE_GEMFILE -u BUNDLE_BIN_PATH -u RUBYOPT -u RUBYLIB \
        dart run sentry_dart_plugin"
      return
    rescue => e
      UI.important "Sentry upload attempt #{i + 1}/3 failed (#{e.message.lines.first&.strip}) — retrying…"
    end
  end
  UI.important "⚠ Sentry symbol upload did not converge. Release is unaffected; " \
               "finish later with: scripts/upload-sentry-symbols.sh (resumable)."
end

# ── iOS lanes ─────────────────────────────────────────────────────────────────

platform :ios do

  TEAM_ID    = "NNFD7CKGLG"
  BUNDLE_ID  = "com.tonyaboud.classmate"

  desc "Headless signing repair: create+install an Apple Distribution cert + " \
       "App Store provisioning profile via the ASC API key. Run this when the " \
       "Mac's keychain has lost the distribution cert (export fails with " \
       "'No signing certificate \"iOS Distribution\" found')."
  lane :fix_signing do
    key = asc_api_key
    UI.user_error!("ASC API key unavailable — set ASC_ISSUER_ID / key path.") if key.nil?
    # Distribution cert (development:false) — installs cert + private key into
    # the login keychain. Reuses an existing one if its private key is present.
    cert(
      api_key:     key,
      development: false,
      team_id:     TEAM_ID,
      output_path: "fastlane/certs",
    )
    # App Store provisioning profile for the app, signed by the cert above.
    # force:true regenerates the profile so it INCLUDES the (possibly new) cert
    # — otherwise a stale Xcode-managed profile references a cert whose private
    # key is no longer on this Mac, and export fails with "doesn't include
    # signing certificate". provisioning_name pins a stable, non-managed name.
    sigh(
      api_key:            key,
      app_identifier:     BUNDLE_ID,
      development:        false,
      force:              true,
      provisioning_name:  "ClassMate AppStore",
      team_id:            TEAM_ID,
      output_path:        "fastlane/profiles",
    )
    UI.success "✅ Distribution cert + App Store profile installed."
  end

  desc "Upload to TestFlight (beta)"
  lane :beta do
    key = asc_api_key
    flutter_build_ios
    upload_to_testflight(
      api_key:                    key,   # nil → falls back to app-specific password
      ipa:                        IOS_IPA,
      # Reliable: upload + set changelog, don't block on processing. The
      # group-distribution path (groups: + waiting) uploaded fine but then
      # errored, so we let App Store Connect handle internal-group
      # distribution (enable "auto-distribute" on the Devs group once).
      skip_waiting_for_build_processing: true,
      changelog:                  "ClassMate beta build — #{Time.now.strftime('%Y-%m-%d')}",
    )
    upload_sentry_symbols   # AFTER the release, so a flaky upload can't block it
    UI.success "✅ Uploaded to TestFlight!"
  end

  desc "Upload existing IPA to TestFlight (skip build)"
  lane :upload do
    upload_to_testflight(
      api_key:                    asc_api_key,
      ipa:                        IOS_IPA,
      skip_waiting_for_build_processing: true,
      changelog:                  "ClassMate beta build — #{Time.now.strftime('%Y-%m-%d')}",
    )
    UI.success "✅ Uploaded to TestFlight!"
  end

  desc "Build, upload, and submit to App Store review (1-command public release)"
  lane :release do
    key = asc_api_key
    flutter_build_ios
    deliver(
      api_key:             key,
      ipa:                 IOS_IPA,
      submit_for_review:   true,    # actually submits for Apple review
      automatic_release:   false,   # you press "Release" after approval
      force:               true,    # skip the HTML preview/confirm prompt
      skip_metadata:       true,    # use the listing already in App Store Connect
      skip_screenshots:    true,
      precheck_include_in_app_purchases: false,
      submission_information: { export_compliance_uses_encryption: false },
    )
    upload_sentry_symbols   # AFTER submission, so a flaky upload can't block it
    UI.success "✅ Submitted to App Store review!"
  end

end

# ── Android lanes ─────────────────────────────────────────────────────────────

platform :android do

  desc "Distribute via Firebase App Distribution (beta)"
  lane :beta do
    flutter_build_android
    firebase_app_distribution(
      app:            "1:682658545733:android:2ce716747ff621c41aa32c",
      groups:         "beta-testers",
      release_notes:  "ClassMate beta — #{Time.now.strftime('%Y-%m-%d')}",
      apk_path:       "../#{APK_PATH}",
    )
    UI.success "✅ Distributed via Firebase!"
  end

  desc "Build AAB and upload to Play Console INTERNAL testing track"
  lane :internal do
    flutter_build_aab
    upload_to_play_store(
      track:                   "internal",
      aab:                     AAB_PATH,
      json_key:                PLAY_JSON,
      skip_upload_apk:         true,
      skip_upload_metadata:    true,
      skip_upload_images:      true,
      skip_upload_screenshots: true,
      release_status:          "completed",
    )
    upload_sentry_symbols   # AFTER the release, so a flaky upload can't block it
    UI.success "✅ Uploaded to Play internal testing!"
  end

  desc "Build AAB and roll out to Play Console PRODUCTION"
  lane :production do
    flutter_build_aab
    upload_to_play_store(
      track:                   "production",
      aab:                     AAB_PATH,
      json_key:                PLAY_JSON,
      skip_upload_apk:         true,
      skip_upload_metadata:    true,
      skip_upload_images:      true,
      skip_upload_screenshots: true,
      # Staged rollout — bump toward 1.0 as you gain confidence, or remove
      # this line to release to 100% immediately.
      rollout:                 "0.2",
    )
    upload_sentry_symbols   # AFTER the release, so a flaky upload can't block it
    UI.success "✅ Rolled out to Play production (20%)!"
  end

end
