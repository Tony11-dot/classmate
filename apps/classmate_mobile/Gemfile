source "https://rubygems.org"

# fastlane drives the store uploads (see fastlane/Fastfile). Pinned loosely so
# CI and local machines resolve the same major line.
gem "fastlane"

# fastlane plugins declared in fastlane/Pluginfile (firebase_app_distribution).
plugins_path = File.join(File.dirname(__FILE__), "fastlane", "Pluginfile")
eval_gemfile(plugins_path) if File.exist?(plugins_path)
