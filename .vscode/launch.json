{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ClassMate (Simulator)",
      "request": "launch",
      "type": "dart",
      "program": "apps/classmate_mobile/lib/main.dart",
      "args": [
        "--dart-define=CM_CLEAR_SESSION=true",
        "--dart-define=CM_API_BASE_URL=http://localhost:3001"
      ]
    },
    {
      "name": "ClassMate (Device)",
      "request": "launch",
      "type": "dart",
      "program": "apps/classmate_mobile/lib/main.dart",
      "args": [
        "--dart-define=CM_CLEAR_SESSION=true",
        "--dart-define=CM_API_BASE_URL=http://Tonys-MacBook-Air.local:3001"
      ]
    }
  ]
}
